{"diagnostics":"DiagnosticStore { revision: Revision(0), diagnostics: [] }","path":"/private/tmp/mech-benchmark-publication/experiments/mech/pidigits-performance-v1/sources/compact-shared.mec","schema":"mech-native-cst-capture.v1","source":"<state> := <{k<u64>, count<u64>, n<u64>, q<bigint>, r<bigint>, t<bigint>, scratch<bigint>}>\nLabel(count<u64>) => <u64> := io/print(\"\\t:{}\\n\", count)\nNoLabel(count<u64>) => <u64> := 0\nMore(s<state>) => <bool> := s.count < s.n\nProduce(s<state>, digit<u64>) = (next<state>) :=\n  remainder := bigint/subtract-multiple-u64(s.r, s.t, digit)\n  r := bigint/multiply-u64-into(remainder, remainder, 10)\n  q := bigint/multiply-u64-into(s.q, s.q, 10)\n  output := io/print(\"{}\", digit)\n  label := control/if(number/mod(s.count + 1, 10) == 0, Label, NoLabel, s.count + 1)\n  next := {k: s.k, count: s.count + 1, n: s.n, q: q, r: r, t: s.t, scratch: s.scratch}.\nConsume(s<state>, digit<u64>) = (next<state>) :=\n  numerator := bigint/add-multiple-u64(s.r, s.q, 2)\n  r := bigint/multiply-u64-into(numerator, numerator, 2 * s.k + 1)\n  q := bigint/multiply-u64-into(s.q, s.q, s.k)\n  t := bigint/multiply-u64-into(s.t, s.t, 2 * s.k + 1)\n  next := {k: s.k + 1, count: s.count, n: s.n, q: q, r: r, t: t, scratch: s.scratch}.\nExtractStep(s<state>) = (next<state>) :=\n  product := bigint/multiply-u64-into(s.scratch, s.q, 3)\n  sum := bigint/add-into(product, product, s.r)\n  first := bigint/floor-u64(sum, s.t)\n  numerator := bigint/add-into(s.scratch, s.scratch, s.q)\n  second := bigint/floor-u64(numerator, s.t)\n  next := (first == second ? | true => Produce(s, first) | * => s).\nStep(s<state>) = (next<state>) :=\n  advanced := Consume(s, 0)\n  next := (bigint/less-equal(advanced.q, advanced.r) ? | true => ExtractStep(advanced) | * => advanced).\nNeedsSpace(column<u64>) => <bool> := column < 10\nSpace(column<u64>) = (next<u64>) :=\n  output := io/print(\" \")\n  next := column + 1.\nFinish(count<u64>) = (done<u64>) :=\n  column := control/while(number/mod(count, 10), NeedsSpace, Space)\n  done := Label(count).\ninitial := {k: 1, count: 0, n: io/argument-u64(1), q: bigint/new(1), r: bigint/new(0), t: bigint/new(1), scratch: bigint/new(0)}\nstate := control/while(initial, More, Step)\nfinished := control/if(number/mod(state.count, 10) != 0, Finish, NoLabel, state.count)\n","syntax":{"children":[{"children":[{"children":[{"children":[{"children":[{"children":[{"children":[{"end":1,"kind":"LeftAngle","start":0,"text":"<","token":true},{"children":[{"end":2,"kind":"Alpha","start":1,"text":"s","token":true},{"end":3,"kind":"Alpha","start":2,"text":"t","token":true},{"end":4,"kind":"Alpha","start":3,"text":"a","token":true},{"end":5,"kind":"Alpha","start":4,"text":"t","token":true},{"end":6,"kind":"Alpha","start":5,"text":"e","token":true}],"end":6,"kind":"Identifier","start":1,"token":false},{"end":7,"kind":"RightAngle","start":6,"text":">","token":true},{"end":8,"kind":"Whitespace","start":7,"text":" ","token":true},{"end":10,"kind":"DefineOperatorToken","start":8,"text":":=","token":true},{"end":11,"kind":"Whitespace","start":10,"text":" ","token":true},{"children":[{"end":12,"kind":"LeftAngle","start":11,"text":"<","token":true},{"children":[{"children":[{"children":[{"end":13,"kind":"LeftBrace","start":12,"text":"{","token":true},{"children":[{"end":14,"kind":"Alpha","start":13,"text":"k","token":true}],"end":14,"kind":"Identifier","start":13,"token":false},{"children":[{"end":15,"kind":"LeftAngle","start":14,"text":"<","token":true},{"children":[{"children":[{"children":[{"children":[{"end":16,"kind":"Alpha","start":15,"text":"u","token":true},{"end":17,"kind":"Digit","start":16,"text":"6","token":true},{"end":18,"kind":"Digit","start":17,"text":"4","token":true}],"end":18,"kind":"Identifier","start":15,"token":false}],"end":18,"kind":"KindScalar","start":15,"token":false}],"end":18,"kind":"Kind","start":15,"token":false}],"end":18,"kind":"KindWithOption","start":15,"token":false},{"end":19,"kind":"RightAng