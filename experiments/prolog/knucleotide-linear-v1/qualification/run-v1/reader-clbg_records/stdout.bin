  "schema":"prolog-source-reader-v1",
  "source":"/private/tmp/mech-benchmark-completion/experiments/prolog/knucleotide-linear-v1/support/clbg_records.pl",
  "source_text":":- module(clbg_records, [line/1, header/1, comment/1, third_header/1, sequence/2]).\nline(Line) :-\n    read_string(user_input, \"\\r\\n\", \"\", Separator, Raw),\n    (   Separator =:= -1, Raw == \"\"\n    ->  Line = end_of_file\n    ;   Line = Raw\n    ).\n\nheader(Line) :- sub_string(Line, 0, 1, _, \">\").\ncomment(Line) :- sub_string(Line, 0, 1, _, \";\").\n\nthird_header(Line) :-\n    sub_string(Line, 0, 6, _, \">THREE\"),\n    string_length(Line, Length),\n    (   Length =:= 6\n    ->  true\n    ;   get_string_code(7, Line, Next),\n        (Next =:= 32 -> true ; Next =:= 9)\n    ).\n\nsequence(ReversedChunks, Sequence) :-\n    reverse(ReversedChunks, Chunks),\n    atomics_to_string(Chunks, \"\", Sequence).\n",
  "version": [10, 0, 2 ]
}
