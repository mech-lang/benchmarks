  "work_findings": [
    {
      "contract": "one conversion before seven full scans",
      "source": "sources/knucleotide/compact.pl:113-122",
      "wam": "qualification/run-v1/inspect-compact/candidate.wam:11-67",
      "finding": "main reads the selected record and length, calls atom_string/2 once at instruction 13, passes that atom as all_maps/4 argument 2 at instruction 42, constructs widths 1,2,3,4,6,12,18, then consumes all returned tables."
    },
    {
      "contract": "all windows and complete maps",
      "source": "sources/knucleotide/compact.pl:39-60",
      "wam": "qualification/run-v1/inspect-compact/candidate.wam:79-143,433-465",
      "finding": "Each width allocates an ordinary hash table. Index runs from 1 through Length; each base updates the rolling 2-bit key under the width mask. Every Index>=Width performs ht_get/default zero, Count=Old+1 and ht_put; recursive calls preserve Sequence and table. There is no query-only filter or early successful-loop exit."
    },
    {
      "contract": "all tables retained through final output",
      "source": "sources/knucleotide/compact.pl:55-60,113-122",
      "wam": "qualification/run-v1/inspect-compact/candidate.wam:40-67,433-465",
      "finding": "The recursive table list binds every constructed table before returning to main. Singles and doubles feed full frequencies; the other five tables feed the five corresponding queries. The ordinary table retains arbitrary keys and resizes; no fixed observed-key capacity is substituted."
    },
    {
      "contract": "frequencies and queries",
      "source": "sources/knucleotide/compact.pl:62-111",
      "wam": "qualification/run-v1/inspect-compact/candidate.wam:147-206,469-510,565-614",
      "finding": "ht_pairs enumerates every singleton/doubleton; negative count and numeric base-4 key implement decreasing count then A<C<G<T ordering, denominator is max(0,L-K+1), output uses three decimals and blank separators. Query keys use the unchanged five words and query counts use their complete width-specific maps."
    },
    {
      "contract": "binary FASTA record and invalid-input behavior",
      "source": "sources/knucleotide/compact.pl:7-37; support/clbg_records.pl:2-23; support/clbg_io.pl:4-18",
      "finding": "Octet input, exact >THREE token, CR/LF separators, column-zero comments, stop at next header or EOF, case-folded A/C/G/T and exact invalid-base error are unchanged. No source change outside the one conversion and its argument substitution."
    }
  ],
