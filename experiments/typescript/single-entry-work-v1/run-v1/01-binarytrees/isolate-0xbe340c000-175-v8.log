script-source,87,/private/tmp/mech-benchmark-completion/experiments/typescript/native-stage-v1/run-v1/compile/project/emitted/binarytrees.js,"use strict";\nObject.defineProperty(exports\x2C "__esModule"\x2C { value: true });\nconst process = require("node:process");\n// Typed source draft; compilation\x2C conformance\x2C work and counts are pending.\n/* The Computer Language Benchmarks Game\n   https://salsa.debian.org/benchmarksgame-team/benchmarksgame/\n\n   contributed by L\xe9o Sarrazin\n   multi thread by Andrey Filatkin\n   sequential by Isaac Gouy\n*/\nfunction mainThread() {\n    const maxDepth = Math.max(6\x2C parseInt(process.argv[2]));\n    const stretchDepth = maxDepth + 1;\n    const check = itemCheck(bottomUpTree(stretchDepth));\n    console.log(`stretch tree of depth ${stretchDepth}\\t check: ${check}`);\n    const longLivedTree = bottomUpTree(maxDepth);\n    for (let depth = 4; depth <= maxDepth; depth += 2) {\n        const iterations = 1 << maxDepth - depth + 4;\n        work(iterations\x2C depth);\n    }\n    console.log(`long lived tree of depth ${maxDepth}\\t check: ${itemCheck(longLivedTree)}`);\n}\nfunction work(iterations\x2C depth) {\n    let check = 0;\n    for (let i = 0; i < iterations; i++) {\n        check += itemCheck(bottomUpTree(depth));\n    }\n    console.log(`${iterations}\\t trees of depth ${depth}\\t check: ${check}`);\n}\nclass TreeNode {\n    constructor(left\x2C right) {\n        this.left = left;\n        this.right = right;\n    }\n}\nfunction itemCheck(node) {\n    if (node.left === null || node.right === null) {\n        return 1;\n    }\n    return 1 + itemCheck(node.left) + itemCheck(node.right);\n}\nfunction bottomUpTree(depth) {\n    return depth > 0\n        ? new TreeNode(bottomUpTree(depth - 1)\x2C bottomUpTree(depth - 1))\n        : new TreeNode(null\x2C null);\n}\nmainThread();\n//# sourceMappingURL=binarytrees.js.map
