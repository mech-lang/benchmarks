VALID_THIS('Blob'));\n\n    return PromisePrototypeThen(\n      arrayBuffer(this)\x2C\n      (buffer) => new Uint8Array(buffer));\n  }\n\n  /**\n   * @returns {ReadableStream}\n   */\n  stream() {\n    if (!isBlob(this))\n      throw new ERR_INVALID_THIS('Blob');\n    return createBlobReaderStream(this[kHandle].getReader());\n  }\n\n  /**\n   * @returns {ReadableStream}\n   */\n  textStream() {\n    if (!isBlob(this))\n      throw new ERR_INVALID_THIS('Blob');\n    const stream = createBlobReaderStream(this[kHandle].getReader());\n    const decoder = lazyTextDecoderStream();\n    return stream.pipeThrough(decoder);\n  }\n}\n\nfunction TransferableBlob(handle\x2C length\x2C type = '') {\n  ObjectSetPrototypeOf(this\x2C Blob.prototype);\n  markTransferMode(this\x2C true\x2C false);\n  this[kHandle] = handle;\n  this[kType] = type;\n  this[kLength] = length;\n}\n\nObjectSetPrototypeOf(TransferableBlob.prototype\x2C Blob.prototype);\nObjectSetPrototypeOf(TransferableBlob\x2C Blob);\n\nfunction createBlob(handle\x2C length\x2C type = '') {\n  const transferredBlob = new TransferableBlob(handle\x2C length\x2C type);\n\n  // Fix issues like: https://github.com/nodejs/node/pull/49730#discussion_r1331720053\n  transferredBlob.constructor = Blob;\n\n  return transferredBlob;\n}\n\nObjectDefineProperty(Blob.prototype\x2C SymbolToStringTag\x2C {\n  __proto__: null\x2C\n  configurable: true\x2C\n  value: 'Blob'\x2C\n});\n\nObjectDefineProperties(Blob.prototype\x2C {\n  size: kEnumerableProperty\x2C\n  type: kEnumerableProperty\x2C\n  slice: kEnumerableProperty\x2C\n  stream: kEnumerableProperty\x2C\n  textStream: kEnumerableProperty\x2C\n  text: kEnumerableProperty\x2C\n  arrayBuffer: kEnumerableProperty\x2C\n  bytes: kEnumerableProperty\x2C\n});\n\nfunction resolveObjectURL(url) {\n  url = `${url}`;\n  try {\n    const parsed = new URL(url);\n\n    const split = StringPrototypeSplit(parsed.pathname\x2C ':'\x2C 3);\n\n    if (split.length !== 2)\n      return;\n\n    const {\n      0: base\x2C\n      1: id\x2C\n    } = split;\n\n    if (base !== 'nodedata')\n      return;\n\n    const ret = getDataObject(id);\n\n    if (ret === undefined)\n      return;\n\n    const {\n      0: handle\x2C\n      1: length\x2C\n      2: type\x2C\n    } = ret;\n\n    if (handle !== undefined)\n      return createBlob(handle\x2C length\x2C type);\n  } catch {\n    // If there's an error\x2C it's ignored and nothing is returned\n  }\n}\n\n// TODO(@jasnell): Now that the File class exists\x2C we might consider having\n// this return a `File` instead of a `Blob`.\nfunction createBlobFromFilePath(path\x2C options) {\n  const maybeBlob = _createBlobFromFilePath(path);\n  if (maybeBlob === undefined) {\n    return lazyDOMException('The blob could not be read'\x2C 'NotReadableError');\n  }\n  const { 0: blob\x2C 1: length } = maybeBlob;\n  const res = createBlob(blob\x2C length\x2C options?.type);\n  res[kNotCloneable] = true;\n  return res;\n}\n\nfunction arrayBuffer(blob) {\n  const { promise\x2C resolve\x2C reject } = PromiseWithResolvers();\n  const reader = blob[kHandle].getReader();\n  const buffers = [];\n  const readNext = () => {\n    reader.pull((status\x2C buffer) => {\n      if (status === 0) {\n        // EOS\x2C concat & resolve\n        // buffer should be undefined here\n        resolve(concat(buffers));\n        return;\n      } else if (status < 0) {\n        // The read could fail for many different reasons when reading\n        // from a non-memory resident blob part (e.g. file-backed blob).\n        // The error details the system error code.\n        const error = lazyDOMException('The blob could not be read'\x2C 'NotReadableError');\n        reject(error);\n        return;\n      }\n      if (buffer !== undefined)\n        buffers.push(buffer);\n      queueMicrotask(() => readNext());\n    });\n  };\n  readNext();\n  return promise;\n}\n\nfunction createBlobReaderStream(reader) {\n  return new lazyReadableStream({\n    type: 'bytes'\x2C\n    start(c) {\n      // There really should only be one read at a time so using an\n      // array here is purely defensive.\n      this.pendingPulls = [];\n      // Register a wakeup callback that the C++ side can invoke\n      // when new data is available after a STATUS_BLOCK.\n      reader.setWakeup(() => {\n        if (this.pendingPulls.length > 0) {\n          this.readNext(c);\n        }\n      });\n    }\x2C\n    pull(c) {\n      const { promise\x2C resolve\x2C reject } = PromiseWithResolvers();\n      this.pendingPulls.push({ resolve\x2C reject });\n      this.readNext(c);\n      return promise;\n    }\x2C\n    readNext(c) {\n      reader.pull((status\x2C buffer) => {\n        // If pendingPulls is empty here\x2C the stream had to have\n        // been canceled\x2C and we don't really care about the result.\n        // We can simply exit.\n        if (this.pendingPulls.length === 0) {\n          return;\n        }\n        if (status === 0) {\n          // EOS\n          c.close();\n          // This is to signal the end for byob readers\n          // see https://streams.spec.whatwg.org/#example-rbs-pull\n          c.byobRequest?.respond(0);\n          const pending = this.pendingPulls.shift();\n          pending.resolve();\n          return;\n        } else if (status < 0) {\n          // The read could fail for many different reasons when reading\n          // from a non-memory resident blob part (e.g. file-backed blob).\n          // The error details the system error code.\n          const error =\n            lazyDOMException('The blob could not be read'\x2C\n                             'NotReadableError');\n          const pending = this.pendingPulls.shift();\n          c.error(error);\n          pending.reject(error);\n          return;\n        } else if (status === 2) {\n          // STATUS_BLOCK: No data available yet. The wakeup callback\n          // registered in start() will re-invoke readNext when data\n          // arrives.\n          return;\n        }\n        // ReadableByteStreamController.enqueue errors if we submit a\n        // 0-length buffer. We need to check for that here.\n        if (buffer !== undefined && buffer.byteLength !== 0) {\n          c.enqueue(new Uint8Array(buffer));\n        }\n        // We keep reading until we either reach EOS\x2C some error\x2C or\n        // we hit the flow rate of the stream (c.desiredSize).\n        // We use setImmediate here because we have to allow the event\n        // loop to turn in order to process any pending i/o. Using\n        // queueMicrotask won't allow the event loop to turn.\n        setImmediate(() => {\n          if (c.desiredSize < 0) {\n            // A manual backpressure check.\n            if (this.pendingPulls.length !== 0) {\n              const pending = this.pendingPulls.shift();\n              pending.resolve();\n            }\n            return;\n          }\n          this.readNext(c);\n        });\n      });\n    }\x2C\n    cancel(reason) {\n      // Reject any currently pending pulls here.\n      for (const pending of this.pendingPulls) {\n        pending.reject(reason);\n      }\n      this.pendingPulls = [];\n    }\x2C\n  // We set the highWaterMark to 0 because we do not want the stream to\n  // start reading immediately on creation. We want it to wait until read\n  // is called.\n  }\x2C { highWaterMark: 0 });\n}\n\nmodule.exports = {\n  Blob\x2C\n  createBlob\x2C\n  createBlobFromFilePath\x2C\n  isBlob\x2C\n  kHandle\x2C\n  resolveObjectURL\x2C\n  TransferableBlob\x2C\n  createBlobReaderStream\x2C\n};\n
