ototype(original\x2C primordials\x2C name);\n  copyPrototype(original.prototype\x2C primordials\x2C `${name}Prototype`);\n});\n\n// Create copies of abstract intrinsic prototypes that are not directly exposed\n// on the global object and which do not have corresponding constructors.\n[\n  {\n    name: 'ArrayIteratorPrototype'\x2C\n    original: Reflect.getPrototypeOf(Array.prototype[Symbol.iterator]())\x2C\n  }\x2C\n  {\n    name: 'AsyncFunctionPrototype'\x2C\n    original: Reflect.getPrototypeOf(async function() {})\x2C\n  }\x2C\n  {\n    name: 'AsyncGeneratorFunctionPrototype'\x2C\n    original: Reflect.getPrototypeOf(async function*() {})\x2C\n  }\x2C\n  {\n    name: 'AsyncIteratorPrototype'\x2C\n    original: Reflect.getPrototypeOf(Reflect.getPrototypeOf(async function*() {}).prototype)\x2C\n  }\x2C\n  {\n    name: 'GeneratorFunctionPrototype'\x2C\n    original: Reflect.getPrototypeOf(function*() {})\x2C\n  }\x2C\n  {\n    name: 'IteratorHelperPrototype'\x2C\n    original: Reflect.getPrototypeOf(primordials.IteratorPrototypeDrop({ __proto__: null }\x2C null))\x2C\n  }\x2C\n  {\n    name: 'MapIteratorPrototype'\x2C\n    original: Reflect.getPrototypeOf(new primordials.Map()[Symbol.iterator]())\x2C\n  }\x2C\n  {\n    name: 'RegExpStringIteratorPrototype'\x2C\n    original: Reflect.getPrototypeOf(primordials.RegExp.prototype[Symbol.matchAll]())\x2C\n  }\x2C\n  {\n    name: 'SetIteratorPrototype'\x2C\n    original: Reflect.getPrototypeOf(new primordials.Set()[Symbol.iterator]())\x2C\n  }\x2C\n  {\n    name: 'StringIteratorPrototype'\x2C\n    original: Reflect.getPrototypeOf(String.prototype[Symbol.iterator]())\x2C\n  }\x2C\n  {\n    name: 'WrapForValidIteratorPrototype'\x2C\n    original: Reflect.getPrototypeOf(primordials.IteratorFrom({ __proto__: null }))\x2C\n  }\x2C\n].forEach(({ name\x2C original }) => {\n  primordials[name] = original;\n  copyPrototype(original\x2C primordials\x2C name);\n});\n\n/* eslint-enable node-core/prefer-primordials */\n\nconst {\n  Array: ArrayConstructor\x2C\n  ArrayPrototypeForEach\x2C\n  ArrayPrototypeMap\x2C\n  ArrayPrototypePushApply\x2C\n  ArrayPrototypeSlice\x2C\n  FinalizationRegistry\x2C\n  FunctionPrototypeCall\x2C\n  Map\x2C\n  ObjectDefineProperties\x2C\n  ObjectDefineProperty\x2C\n  ObjectFreeze\x2C\n  ObjectSetPrototypeOf\x2C\n  Promise\x2C\n  PromisePrototypeThen\x2C\n  PromiseResolve\x2C\n  ReflectApply\x2C\n  ReflectConstruct\x2C\n  ReflectGet\x2C\n  ReflectSet\x2C\n  RegExp\x2C\n  RegExpPrototype\x2C\n  RegExpPrototypeExec\x2C\n  RegExpPrototypeGetDotAll\x2C\n  RegExpPrototypeGetFlags\x2C\n  RegExpPrototypeGetGlobal\x2C\n  RegExpPrototypeGetHasIndices\x2C\n  RegExpPrototypeGetIgnoreCase\x2C\n  RegExpPrototypeGetMultiline\x2C\n  RegExpPrototypeGetSource\x2C\n  RegExpPrototypeGetSticky\x2C\n  RegExpPrototypeGetUnicode\x2C\n  Set\x2C\n  SymbolIterator\x2C\n  SymbolMatch\x2C\n  SymbolMatchAll\x2C\n  SymbolReplace\x2C\n  SymbolSearch\x2C\n  SymbolSpecies\x2C\n  SymbolSplit\x2C\n  WeakMap\x2C\n  WeakRef\x2C\n  WeakSet\x2C\n} = primordials;\n\n\n/**\n * Creates a class that can be safely iterated over.\n *\n * Because these functions are used by `makeSafe`\x2C which is exposed on the\n * `primordials` object\x2C it's important to use const references to the\n * primordials that they use.\n * @template {Iterable} T\n * @template {*} TReturn\n * @template {*} TNext\n * @param {(self: T) => IterableIterator<T>} factory\n * @param {(...args: [] | [TNext]) => IteratorResult<T\x2C TReturn>} next\n * @returns {Iterator<T\x2C TReturn\x2C TNext>}\n */\nconst createSafeIterator = (factory\x2C next) => {\n  class SafeIterator {\n    constructor(iterable) {\n      this._iterator = factory(iterable);\n    }\n    next() {\n      return next(this._iterator);\n    }\n    [SymbolIterator]() {\n      return this;\n    }\n  }\n  ObjectSetPrototypeOf(SafeIterator.prototype\x2C null);\n  ObjectFreeze(SafeIterator.prototype);\n  ObjectFreeze(SafeIterator);\n  return SafeIterator;\n};\n\nprimordials.SafeArr