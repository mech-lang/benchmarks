{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": false,
    "useDefineForClassFields": false,
    "outDir": "./emitted",
    "rootDir": ".",
    "sourceMap": true,
    "inlineSources": true
  },
  "files": [
    "binarytrees.ts",
    "fannkuchredux.ts",
    "fasta.ts",
    "knucleotide.ts",
    "mandelbrot.ts",
    "nbody.ts",
    "pidigits.ts",
    "regexredux.ts",
    "revcomp.ts",
    "spectralnorm.ts"
  ]
}
