# Janet adaptation of the retained Rex Kerr / Isaac Gouy permutation algorithm.
(defn fannkuch [n]
  (if (zero? n) [0 0]
    (do
      (def original (seq [i :range [0 n]] i))
      (def permutation (array/new-filled n 0))
      (def counts (array/new-filled n 0))
      (var rank n)
      (var ordinal 0)
      (var checksum 0)
      (var maximum 0)
      (var done false)
      (while (not done)
        (while (not= rank 1)
          (put counts (dec rank) rank)
          (-- rank))
        (for i 0 n (put permutation i (original i)))
        (var flips 0)
        (while (not= (permutation 0) 0)
          (def last (permutation 0))
          (var i 0)
          (while (< (* 2 i) last)
            (def temporary (permutation i))
            (put permutation i (permutation (- last i)))
            (put permutation (- last i) temporary)
            (++ i))
          (++ flips))
        (set maximum (max maximum flips))
        (+= checksum (if (zero? (% ordinal 2)) flips (- flips)))
        (var carry true)
        (while carry
          (if (= rank n)
            (do (set done true) (set carry false))
            (do
              (def first (original 0))
              (for i 0 rank (put original i (original (inc i))))
              (put original rank first)
              (put counts rank (dec (counts rank)))
              (if (> (counts rank) 0) (set carry false) (++ rank)))))
        (++ ordinal))
      [checksum maximum])))

(defn main [& args]
  (def n (scan-number (get args 1 "7")))
  (def [checksum maximum] (fannkuch n))
  (print checksum)
  (print (string/format "Pfannkuchen(%d) = %d" n maximum)))
