# New Janet implementation of the Benchmarks Game PBM Mandelbrot requirement.
(defn main [& args]
  (def n (scan-number (get args 1 "200")))
  (file/write stdout (string/format "P4\n%d %d\n" n n))
  (def row @"")
  (for y 0 n
    (buffer/clear row)
    (def ci (- (/ (* 2 y) n) 1))
    (var byte 0)
    (var bits 0)
    (for x 0 n
      (def cr (- (/ (* 2 x) n) 1.5))
      (var zr 0)
      (var zi 0)
      (var rr 0)
      (var ii 0)
      (var iteration 0)
      (while (and (< iteration 50) (<= (+ rr ii) 4))
        (set zi (+ (* 2 zr zi) ci))
        (set zr (+ (- rr ii) cr))
        (set rr (* zr zr))
        (set ii (* zi zi))
        (++ iteration))
      (set byte (+ (* 2 byte) (if (<= (+ rr ii) 4) 1 0)))
      (++ bits)
      (when (= bits 8)
        (buffer/push-byte row byte)
        (set byte 0)
        (set bits 0)))
    (when (> bits 0) (buffer/push-byte row (* byte (math/pow 2 (- 8 bits)))))
    (file/write stdout row)))
