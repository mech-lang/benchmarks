# Janet adaptation of the retained Alexander Fyodorov / Isaac Gouy spigot.
# Only general GMP arithmetic leaves cross the FFI; digit generation stays here.
(ffi/context (or (os/getenv "MECH_GMP_LIBRARY") "libgmp.dylib"))
(ffi/defbind __gmpz_init_set_ui :void [z :ptr value :ulong])
(ffi/defbind __gmpz_clear :void [z :ptr])
(ffi/defbind __gmpz_mul_ui :void [out :ptr value :ptr factor :ulong])
(ffi/defbind __gmpz_add :void [out :ptr left :ptr right :ptr])
(ffi/defbind __gmpz_sub :void [out :ptr left :ptr right :ptr])
(ffi/defbind __gmpz_mul :void [out :ptr left :ptr right :ptr])
(ffi/defbind __gmpz_fdiv_q :void [out :ptr numerator :ptr denominator :ptr])
(ffi/defbind __gmpz_cmp :int [left :ptr right :ptr])
(ffi/defbind __gmpz_get_d :double [z :ptr])
(def mpz-layout (ffi/struct :int :int :ptr))

(defn integer [value]
  (def z (ffi/write mpz-layout [0 0 nil]))
  (__gmpz_init_set_ui z value)
  z)

(defn main [& args]
  (def target (scan-number (get args 1 "30")))
  (def numerator (integer 1))
  (def denominator (integer 1))
  (def accumulator (integer 0))
  (def combined (integer 0))
  (def digit (integer 0))
  (def next-digit (integer 0))
  (var k 0)
  (var factor 1)
  (var printed 0)
  (def row @"")
  (while (< printed target)
    (++ k)
    (+= factor 2)
    (__gmpz_mul_ui digit numerator 2)
    (__gmpz_mul_ui numerator numerator k)
    (__gmpz_add accumulator accumulator digit)
    (__gmpz_mul_ui accumulator accumulator factor)
    (__gmpz_mul_ui denominator denominator factor)
    (when (> (__gmpz_cmp accumulator numerator) 0)
      (__gmpz_mul_ui combined numerator 3)
      (__gmpz_add combined combined accumulator)
      (__gmpz_fdiv_q digit combined denominator)
      (__gmpz_add combined combined numerator)
      (__gmpz_fdiv_q next-digit combined denominator)
      (when (zero? (__gmpz_cmp digit next-digit))
        (buffer/push-byte row (+ 48 (__gmpz_get_d digit)))
        (++ printed)
        (when (or (zero? (% printed 10)) (= printed target))
          (while (< (length row) 10) (buffer/push-byte row 32))
          (file/write stdout row (string/format "\t:%d\n" printed))
          (buffer/clear row))
        (when (< printed target)
          (__gmpz_mul combined denominator digit)
          (__gmpz_sub accumulator accumulator combined)
          (__gmpz_mul_ui accumulator accumulator 10)
          (__gmpz_mul_ui numerator numerator 10)))))
  (each z [numerator denominator accumulator combined digit next-digit] (__gmpz_clear z)))
