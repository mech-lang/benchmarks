+static inline bool mech_witness_enabled(void) {
+  static int enabled = -1;
+  if (enabled < 0) {
+    const char* flag = getenv("MECH_BQN_COUNT_WITNESS");
+    enabled = flag && flag[0]=='1' && flag[1]=='\0';
+  }
+  return enabled;
+}
+static inline void mech_witness_write(const char* line, int n) {
+  if (n>0 && n<1024) (void)write(STDERR_FILENO, line, (size_t)n);
+}
+typedef struct MechCountWitness {
+  const char* path;
+  u64 call, n, rank, el_type;
+  bool boxed;
+  u64 lookups, updates, inserts, increments;
+  u64 initial_capacity, final_capacity, growths, unique;
+} MechCountWitness;
+static inline void mech_witness_count(const MechCountWitness* w) {
+  if (!mech_witness_enabled()) return;
+  char line[1024];
+  int n = snprintf(line, sizeof(line),
+    "MECH_COUNT_WITNESS {\"pid\":%ld,\"call\":%llu,\"path\":\"%s\","
+    "\"n\":%llu,\"rank\":%llu,\"el_type\":%llu,\"boxed\":%s,"
+    "\"lookups\":%llu,\"updates\":%llu,\"inserts\":%llu,\"increments\":%llu,"
+    "\"initial_capacity\":%llu,\"final_capacity\":%llu,\"growths\":%llu,\"unique\":%llu}\n",
+    (long)getpid(), (unsigned long long)w->call, w->path,
+    (unsigned long long)w->n, (unsigned long long)w->rank,
+    (unsigned long long)w->el_type, w->boxed?"true":"false",
+    (unsigned long long)w->lookups, (unsigned long long)w->updates,
+    (unsigned long long)w->inserts, (unsigned long long)w->increments,
+    (unsigned long long)w->initial_capacity, (unsigned long long)w->final_capacity,
+    (unsigned long long)w->growths, (unsigned long long)w->unique);
+  mech_witness_write(line, n);
+}
