inc(x<u64>) => (next<u64>) := next := x + 1u64.
dec(x<i64>) => (next<i64>) := next := x - 1i64.
half(x<f64>) => (next<f64>) := next := x * 0.5.
identity(x<bool>) => (next<bool>) := next := x.
unsigned := seed<u64> |25> inc
signed := start<i64> |3> dec
floating := real<f64> |2> half
boolean := enabled<bool> |0> identity
