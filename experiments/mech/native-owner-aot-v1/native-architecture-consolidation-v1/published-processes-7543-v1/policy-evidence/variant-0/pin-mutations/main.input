./! Same-Object image/symbol binding and compiled launcher dispatch.
use std::ffi::c_void;
use mech_gpu::native_artifact::{NATIVE_PROGRAM_LINK_IDENTITY_BYTES, launch::{BuildOwnedHostedBinding, run_benchmark_program_application}};
unsafe extern "C" {
    #[link_name = "mech_canonical_program_entry_v1"]
    fn linked_entry(frame: *mut c_void) -> u64;
    #[link_name = "mech_canonical_program_identity_v1_8ea609926d01958f8097600d2e12c69cd50ef5fdb4bb351b73cd29d9207bc63c"]
    static LINKED_IDENTITY: [u8; NATIVE_PROGRAM_LINK_IDENTITY_BYTES];
}
fn catalog() -> Result<mech_core::FunctionCatalog, String> {
    let mut builder = mech_core::FunctionCatalogBuilder::new();
mech_engine::linked_factories::ACCESS_RANGE.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::ACCESS_SCALAR.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::COMPARE_EQ.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::CONVERT_KIND.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::CONVERT_SET.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::CORE_COMPOSITE_PACK.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::CORE_ENUM_PACK.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::MAP_HISTOGRAM.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::MAP_KEYS.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::MAP_VALUES.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::NUMBER_FORMAT.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::RANGE_EXCLUSIVE.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::RANGE_INCLUSIVE.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::SEQUENCE_LENGTH.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::SEQUENCE_SORT_INDICES.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::SET_ELEMENT_OF.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::STATS_SUM_COLUMN.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::STRING_CONCAT.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::TEXT_JOIN.install(&mut builder).map_err(|error| format!("{error:?}"))?;
mech_engine::linked_factories::TEXT_LINES.install(&mut builder).map_err(|error| format!("{error:?}"))?;
    builder.build().map_err(|error| format!("{error:?}"))
}
fn main() {
    // SAFETY: build.rs verifies the unchanged Object/images and all generated
    // inputs. Entry, identity and images belong to that SAME checked build.
    let binding = unsafe { BuildOwnedHostedBinding::from_build_owned_image(
        include_bytes!("../native-descriptor.bin"), include_bytes!("../native-resources.json"),
        &LINKED_IDENTITY, linked_entry, catalog, "canonical-artifact-program-object-benchmark-cli",
    ) };
    if let Err(error) = run_benchmark_program_application(binding, std::env::args_os().skip(1)) {
        eprintln!("{error}"); std::process::exit(1);
    }
}
