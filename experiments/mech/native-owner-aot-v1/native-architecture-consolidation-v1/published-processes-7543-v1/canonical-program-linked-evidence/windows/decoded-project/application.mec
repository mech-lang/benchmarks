+> sequence

windows(s<string>, width<u64>) => (out<[string]>) :=
  n := sequence/length(s)
  out := [
    s[(i + 1u64)..=(i + width)]
    | i <- 0u64..=n, width > 0u64, width <= n - i
  ].
windowed := windows(input<string>, width<u64>)
closed-range := 1u64..2u64..=5u64
exclusive := 1u64..stop<u64>
inclusive := 1u64..=stop
stepped := 1u64..increment<u64>..stop
stepped-inclusive := 1u64..increment..=stop
converted<[f64]> := stepped
input-length := sequence/length(input)
first := (input-length? | 0u64 => "" | * => input[1u64])
copy := input[:]
quotient := 1u64 / divisor<u64>
