+                .metadata()
+                .plan
+                .values()
+                .len()
+                .checked_add(self.state.output_cursor)
+                .and_then(|n| u32::try_from(n).ok())
+                .ok_or_else(|| invalid("typed output slot overflow"))?;
+            self.state
+                .arena
+                .put(target, &value, &mut self.state.control.work)?;
+            self.state.output_cursor += 1;
+            Ok(None)
