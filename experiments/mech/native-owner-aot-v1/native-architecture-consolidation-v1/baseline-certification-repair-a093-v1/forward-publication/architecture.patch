+                .state
+                .collections
+                .take()
+                .ok_or_else(|| invalid("collection helper without state"))?;
+            let result = state.helper(
+                &mut CollectionExecution::new(self),
+                site,
+                [args[0], args[1]],
+            );
+            self.state.collections = Some(state);
+            let result = result?;
+            self.state.consumed = true;
+            Ok(result)
