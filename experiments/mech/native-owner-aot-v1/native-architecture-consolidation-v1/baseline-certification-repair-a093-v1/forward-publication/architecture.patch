-                    (*raw).helper = original;
-                }
-                status
-            },
-            args,
-            outputs,
-            caps,
-            memory,
-        );
-        let observations =
-            RANGE_SCRATCH_OBSERVATIONS.with(|rows| core::mem::take(&mut *rows.borrow_mut()));
-        (outcome, observations)
-    }
