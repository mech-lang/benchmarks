+        arena.put(0, &good, &mut work).unwrap_err(),
+        NativeValueError::GenerationExhausted
+    );
+    assert_eq!(
+        arena.take(handle, &mut work).unwrap_err(),
+        NativeValueError::GenerationExhausted
+    );
+    assert!(arena.get(handle, &mut work).is_ok());
+}
