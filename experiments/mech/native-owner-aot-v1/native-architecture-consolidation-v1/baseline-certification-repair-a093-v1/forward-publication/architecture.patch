+pub(in crate::native_artifact) enum GlobalHelper {
+    Library,
+    Move,
+    Collection,
+    Output(OutputIndex),
+    WindowPrepare,
+    WindowFinish,
+    StringMapPrepare,
+    StringMapFinish,
+    BorrowedStringsPrepare,
+    BorrowedStringFailure,
