-            let demand = state
-                .test_text_join_demand(ctx, usize::try_from(site).ok()?)
-                .ok()??;
-            Some((demand, ctx.library.memory_budget(), ctx.control.work.used()))
-        })();
-        let mut pressure_failure = false;
-        let mut ballast = None;
-        let mut global_remaining = None;
