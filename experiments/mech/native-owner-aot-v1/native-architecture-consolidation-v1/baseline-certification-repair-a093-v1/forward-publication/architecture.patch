+pub(in crate::native_artifact::program::runtime) fn artifact_source(
+    source: &str,
+) -> mech_engine::ProgramArtifact {
+    let parsed = parse_canonical_document(
+        TextSnapshot::new(DocumentId(0x50524f54), Revision(1), source).unwrap(),
+        ParseConfig::default(),
+    );
