+fn phase_protocol_rejects_forged_early_checkpoint_completion_and_frame_phase() {
+    let artifact = artifact();
+    let jit = crate::native_artifact::JitProgramArtifact::compile(
+        &artifact,
+        &mech_stdlib::source_catalog(),
