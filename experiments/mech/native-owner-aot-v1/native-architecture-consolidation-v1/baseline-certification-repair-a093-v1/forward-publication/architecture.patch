+        let mut output = vec![None; artifact.outputs().len()];
+        let result = execute(
+            jit.descriptor(),
+            |raw| {
+                // SAFETY: the test receives this synchronous owned frame only.
+                let frame = unsafe { &mut *raw };
+                let boundary = jit
+                    .descriptor()
+                    .metadata()
+                    .plan
+                    .activation_boundary()
+                    .unwrap();
+                if mode == 0 {
+                    frame.phase = crate::native_artifact::program::protocol::abi::PHASE_TURN;
+                } else if mode == 1 {
+                    return STATUS_OK;
