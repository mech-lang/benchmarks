-        let index = self.index(handle)?;
-        let next = handle
-            .generation
-            .checked_add(1)
-            .ok_or(NativeValueError::GenerationExhausted)?;
-        self.generations.values_mut()[index] = next;
-        self.values.values_mut()[index]
-            .take()
-            .ok_or(NativeValueError::StaleHandle)
-    }
