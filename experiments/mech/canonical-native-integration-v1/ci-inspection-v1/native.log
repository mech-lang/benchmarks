2026-10-23T00:15:06.3803338Z env:
2026-10-23T00:15:06.3805122Z   RECORD_CHECKOUT_IDENTITY: case "$VALIDATION_KIND" in
  integration-merge|exact-ref) ;;
  *) echo "unsupported validation kind: $VALIDATION_KIND" >&2; exit 64 ;;
esac
test -n "$REQUESTED_REF"

actual_sha=$(git rev-parse HEAD)
test -n "$CHECKOUT_SHA"
test "$actual_sha" = "$CHECKOUT_SHA"

if [[ "$REQUESTED_REF" =~ ^[0-9a-fA-F]{40}$ || "$REQUESTED_REF" =~ ^[0-9a-fA-F]{64}$ ]]
then
  requested_sha=$(printf '%s' "$REQUESTED_REF" | tr '[:upper:]' '[:lower:]')
  test "$actual_sha" = "$requested_sha"
fi

{
  echo "validation_kind=$VALIDATION_KIND"
  echo "requested_ref=$REQUESTED_REF"
  echo "checkout_ref=$CHECKOUT_REF"
  echo "checkout_sha=$CHECKOUT_SHA"
  echo "actual_sha=$actual_sha"
} | tee -a "$GITHUB_STEP_SUMMARY"

