  first := byte(input, at)
  second := bits/shift-left-wrap(byte(input, at + 1u64), 8u64)
  third := bits/shift-left-wrap(byte(input, at + 2u64), 16u64)
  out := bits/or(first, bits/or(second, third)).
optimal-short-distinct-from(input<[u8]>, word<u64>, at<u64>, end<u64>) => (out<bool>) :=
  out := ((at < end)?
    | true => ((optimal-short-triple(input, at) == word)?
      | true => false
      | false => optimal-short-distinct-from(input, word, at + 1u64, end))
    | false => true).
optimal-short-distinct-triples(input<[u8]>, at<u64>, end<u64>) => (out<bool>) :=
  out := ((at < end)?
    | true => ((optimal-short-distinct-from(input, optimal-short-triple(input, at), at + 1u64, end))?
      | true => optimal-short-distinct-triples(input, at + 1u64, end)
      | false => false)
    | false => true).
optimal-short-forced-literals(input<[u8]>) => (out<bool>) :=
  n := sequence/length(input)
  limit := (75u64 - 10u64 - 1u64) / (9u64 - 1u64)
  out := ((n <= limit)?
    | true => ((n >= 3u64)? | true => optimal-short-distinct-triples(input, 0u64, n - 2u64) | false => true)
    | false => false).
optimal-short-write-literals(bytes<[u8]>, bitbuf<u64>, bitcount<u64>, input<[u8]>, at<u64>, end<u64>, words<[u32]>, lens<[u8]>) => (out<path-written>) :=
  next := ((at < end)?
    | true => path-write-literal(bytes, bitbuf, bitcount, byte(input, at), words, lens)
    | false => {bytes: bytes, bitbuf: bitbuf, bitcount: bitcount})
  out := ((at < end)?
    | true => optimal-short-write-literals(next.bytes, next.bitbuf, next.bitcount, input, at + 1u64, end, words, lens)
    | false => next).
optimal-short-final-block(input<[u8]>, bytes<[u8]>, tables<[u16]>, cache<[u32]>, frequencies<[u32]>, fresh-frequencies<[u32]>, observations<[u32]>, fresh-observations<[u32]>, static-lens<[u8]>, static-words<[u32]>) => (out<path-written>) :=
  n := sequence/length(input)
  short-input! := n <= 8u64
  collected := optimal-collect-block(tables, cache, 0u64, 0u64, input, 0u64, 0u64, bt-minimum(n, 32768u64), 258u64, 258u64, 0u64, frequencies, fresh-frequencies, observations, fresh-observations, 0u64, 0u64, 0u64, 0u64)
  forced-final! := (collected.cache-end == n) && (collected.is-final == 1u64)
  header := block-write-static-header(bytes, 0u64, 0u64, 1u64)
  payload := optimal-short-write-literals(header.bytes, header.bitbuf, header.bitcount, input, 0u64, n, static-words, static-lens)
  out := path-write-literal(payload.bytes, payload.bitbuf, payload.bitcount, 256u64, static-words, static-lens).

optimal-compress(input<[u8]>, output<[u8]>) => (out<[u8]>) :=
  n := sequence/length(input)
  static := block-build-static-codes(deflate-table-reversed)
  bytes := sequence/reserve(output, deflate-compress-bound(n))
  tables := initial-nodes(262144u64)
  cache := [0u32 | i <- 0u64..=1500513u64, i < 1500513u64]
  nodes := sequence/with-capacity(0u64, 305257u64)
  literal := [0u32 | i <- 0u64..=256u64, i < 256u64]
  length-costs := [0u32 | i <- 0u64..=259u64, i < 259u64]
  offset-costs := [0u32 | i <- 0u64..=32u64, i < 32u64]
  saved-literal := [0u32 | i <- 0u64..=256u64, i < 256u64]
  saved-length := [0u32 | i <- 0u64..=259u64, i < 259u64]
  saved-offset := [0u32 | i <- 0u64..=32u64, i < 32u64]
  frequencies := [0u32 | i <- 0u64..=259u64, i < 259u64]
  fresh-frequencies := [0u32 | i <- 0u64..=259u64, i < 259u64]
  previous-observations := [0u32 | i <- 0u64..=10u64, i < 10u64]
  fresh-observations := [0u32 | i <- 0u64..=10u64, i < 10u64]
  observations := [0u32 | i <- 0u64..=10u64, i < 10u64]
  seqs := [{litrunlen-and-length: 0u32, offset: 0u16, offset-slot: 0u16}]
  stream := (optimal-short-forced-literals(input)?
    | true => optimal-short-final-block(input, bytes, tables, cache, frequencies, fresh-frequencies, observations, fresh-observations, static.litlen-lens, static.litlen-codewords)
    | false => optimal-compress-blocks(input, bytes, 0u64, 0u64, tables, cache, nodes, 0u64, 0u64, 0u64, 0u64, 0u64, bt-minimum(n, 32768u64), 258u64, 258u64, 0u64, literal, length-costs, offset-costs, saved-literal, saved-length, saved-offset, frequencies, fresh-frequencies, previous-observations, 0u64, observations, fresh-observations, 0u64, 0u64, seqs, 0u64, static.litlen-lens, static.litlen-codewords, static.offset-lens, static.offset-codewords))
  out := ((stream.bitcount > 0u64)? | true => sequence/append(stream.bytes, huff-byte(stream.bitbuf)) | false => stream.bytes).

deflate-store-uncompressed(input<[u8]>, output<[u8]>) => (out<[u8]>) :=
  n := sequence/length(input)
  bytes := sequence/reserve(output, n + 5u64 * (n / 65535u64 + 1u64))
  stored := ((n == 0u64)?
    | true => {bytes: sequence/append-le-bytes(sequence/append(bytes, 1u8), 4294901760u64, 4u8), bitbuf: 0u64, bitcount: 0u64}
    | false => block-write-stored(bytes, 0u64, 0u64, input, 0u64, n, 1u64))
  out := stored.bytes.

deflate-compress-into(input<[u8]>, output<[u8]>) => (out<[u8]>) :=
  out := ((sequence/length(input) <= 7u64)? | true => deflate-store-uncompressed(input, output) | false => optimal-compress(input, output)).

buffer := sequence/with-capacity(0u8, 6633832u64)
prefixed := sequence/append-sublist(buffer, prefix<[u8]>, 0u64, sequence/length(prefix))
deflate-compress-into(input<[u8]>, prefixed)
