// Shared DEFLATE match-finder routines, translated from libdeflate
// b122c8be1d78b19f6d0a6efc5bb79bfcbb30dd51 and roc-deflate
// 671077457ff7ef3a3d44caf715a3fc595addf379. See deflate-huffman-LICENSES.md.
// Input positions below are zero-based; Mech's matrix selectors are one-based.
+> bits
+> sequence

byte-readable(input<[u8]>, at<u64>) => (out<u64>) :=
  out<u64> := input[at + 1u64].
// List.get defaults to zero; the one-based selector is only formed on the
// readable path, so an arbitrary zero-based U64 offset cannot overflow it.
byte(input<[u8]>, at<u64>) => (out<u64>) :=
  out := ((at < sequence/length(input))? | true => byte-readable(input, at) | false => 0u64).
prefix-readable(input<[u8]>, at<u64>) => (out<u32>) :=
  lo := bits/or(byte-readable(input, at), bits/shift-left-wrap(byte-readable(input, at + 1u64), 8u64))
  hi := bits/or(byte-readable(input, at + 2u64), bits/shift-left-wrap(byte-readable(input, at + 3u64), 8u64))
  out<u32> := bits/or(lo, bits/shift-left-wrap(hi, 16u64)).
// from_le_bytes defaults the entire word to zero when its window is short.
// Guard subtraction before forming any index; this also covers U64::MAX.
load-prefix(input<[u8]>, at<u64>) => (out<u32>) :=
  available := sequence/length(input)
  out := ((available >= 4u64)? | true => ((at <= available - 4u64)? | true => prefix-readable(input, at) | false => 0u32) | false => 0u32).
word-readable(input<[u8]>, at<u64>) => (out<u64>) :=
  a := bits/or(byte-readable(input, at), bits/shift-left-wrap(byte-readable(input, at + 1u64), 8u64))
  b := bits/or(byte-readable(input, at + 2u64), bits/shift-left-wrap(byte-readable(input, at + 3u64), 8u64))
  c := bits/or(byte-readable(input, at + 4u64), bits/shift-left-wrap(byte-readable(input, at + 5u64), 8u64))
  d := bits/or(byte-readable(input, at + 6u64), bits/shift-left-wrap(byte-readable(input, at + 7u64), 8u64))
  lo := bits/or(a, bits/shift-left-wrap(b, 16u64))
  hi := bits/or(c, bits/shift-left-wrap(d, 16u64))
  out := bits/or(lo, bits/shift-left-wrap(hi, 32u64)).
load-word(input<[u8]>, at<u64>) => (out<u64>) :=
  available := sequence/length(input)
  out := ((available >= 8u64)? | true => ((at <= available - 8u64)? | true => word-readable(input, at) | false => 0u64) | false => 0u64).
lz-hash(sequence<u32>, num-bits<u64>) => (out<u64>) :=
  wide<u64> := sequence
  product := bits/and(bits/wrapping-mul(wide, 506832829u64), 4294967295u64)
  out := bits/shift-right-wrap(product, 32u64 - num-bits).

// The caller supplies start <= maximum and an already matched prefix. Roc's
// entry predicate checks the readable window and candidate ordering before
// any loop work. The compressor limits maximum to 258.
// The same three loops as pinned Roc: the first four words, remaining words,
// then trailing bytes. Source recursion keeps each loop's actual arguments.
word-difference(input<[u8]>, str-at<u64>, match-at<u64>, length<u64>) => (out<u64>) :=
  str-word := load-word(input, bits/wrapping-add(str-at, length))
  match-word := load-word(input, bits/wrapping-add(match-at, length))
  out := bits/xor(match-word, str-word).
extend-tail(input<[u8]>, str-at<u64>, match-at<u64>, length<u64>, maximum<u64>) => <u64>
  | (input, str-at, match-at, length, maximum) => ((length < maximum)?
      | false => length
      | true => ((byte(input, bits/wrapping-add(str-at, length)) == byte(input, bits/wrapping-add(match-at, length)))?
          | true => extend-tail(input, str-at, match-at, bits/wrapping-add(length, 1u64), maximum)
          | false => length)).
extend-words(input<[u8]>, str-at<u64>, match-at<u64>, length<u64>, maximum<u64>) => <u64>
  | (input, str-at, match-at, length, maximum) => ((length + 8u64 <= maximum)?
      | false => extend-tail(input, str-at, match-at, length, maximum)
      | true => (word-difference(input, str-at, match-at, length)?
          | 0u64 => extend-words(input, str-at, match-at, bits/wrapping-add(length, 8u64), maximum)
          | difference => bits/wrapping-add(length, bits/shift-right-wrap(bits/trailing-zeros(difference), 3u64)))).
extend-four(input<[u8]>, str-at<u64>, match-at<u64>, length<u64>, four-end<u64>, maximum<u64>) => <u64>
  | (input, str-at, match-at, length, four-end, maximum) => ((length + 8u64 <= four-end)?
      | false => extend-words(input, str-at, match-at, length, maximum)
      | true => (word-difference(input, str-at, match-at, length)?
          | 0u64 => extend-four(input, str-at, match-at, bits/wrapping-add(length, 8u64), four-end, maximum)
          | difference => bits/wrapping-add(length, bits/shift-right-wrap(bits/trailing-zeros(difference), 3u64)))).
extend-length(input<[u8]>, str-at<u64>, match-at<u64>, start<u64>, maximum<u64>) => (out<u64>) :=
  window! := (str-at + maximum <= sequence/length(input)) && (match-at < str-at)
  four-end := start + 32u64
  out := ((four-end <= maximum)?
    | true => extend-four(input, str-at, match-at, start, four-end, maximum)
    | false => extend-words(input, str-at, match-at, start, maximum)).


initial-nodes(count<u64>) => (out<[u16]>) :=
  out := [0u16 | i <- 0u64..=count, i < count].
rebase-node(node<u16>) => (out<u16>) :=
  wide<u64> := node
  out<u16> := ((wide < 32768u64)? | true => 0u64 | false => wide - 32768u64).
rebase-nodes(nodes<[u16]>) => (out<[u16]>) :=
  out := rebase-node(nodes).
node-index(base<u64>, node<u16>) => (out<u64>) :=
  wide<u64> := node
  out := bits/wrapping-sub(bits/wrapping-add(base, wide), 32768u64).

// Binary-tree DEFLATE matching, translated from roc-deflate
// 671077457ff7ef3a3d44caf715a3fc595addf379, BtMatchfinder.roc.
// Concatenate after deflate-matchfinder.mec. See deflate-huffman-LICENSES.md.
// Positions are zero-based; checked Mech matrix selectors are one-based.
// Known parity work before timing: unaligned LE loads,
// prefetch hints, wrapping narrow casts, and physical buffer ownership.

<bt-advanced> := <{tables<[u16]> next-hash3<u64> next-hash4<u64> cache<[u32]> cache-ptr<u64>}>
<bt-state> := <{tables<[u16]> next-hash3<u64> next-hash4<u64>}>
<bt-descent> := <([u16],u64,u64,u16,u64,u64,u64,u64,bool)>
<bt-search-turn> := <([u16],[u32],u64,u64,u64,u16,u64,u64,u64,u64,u64,bool)>

bt-word16(value<u16>) => (out<u64>) :=
  out<u64> := value.
bt-word32(value<u32>) => (out<u64>) :=
  out<u64> := value.
bt-narrow16(value<u64>) => (out<u16>) :=
  out<u16> := bits/and(value, 65535u64).
bt-narrow32(value<u64>) => (out<u32>) :=
  out<u32> := bits/and(value, 4294967295u64).
bt-minimum(a<u64>, b<u64>) => (out<u64>) :=
  out := ((a < b)? | true => a | false => b).
bt-saturating-sub(a<u64>, b<u64>) => (out<u64>) :=
  out := ((a < b)? | true => 0u64 | false => a - b).
bt-pack-entry(low<u64>, high<u64>) => (out<u32>) :=
  out := bt-narrow32(bits/or(bits/and(low, 65535u64), bits/shift-left-wrap(high, 16u64))).
bt-put-entry(cache<[u32]>, ptr<u64>, length<u64>, offset<u64>) => (out<[u32]>) :=
  ~next := cache
  next[bits/wrapping-add(ptr, 1u64)] = bt-pack-entry(length, offset)
  out := next.
bt-child-slot(node<u64>) => (out<u64>) :=
  out := bits/wrapping-mul(bits/and(node, 32767u64), 2u64).
bt-clear(tables<[u16]>, pending-lt<u64>, pending-gt<u64>) => (out<[u16]>) :=
  ~next := tables
  next[bits/wrapping-add(pending-lt, 1u64)] = 0u16
  next[bits/wrapping-add(pending-gt, 1u64)] = 0u16
  out := next.
bt-attach(tables<[u16]>, pending-lt<u64>, pending-gt<u64>, node<u16>) => (out<[u16]>) :=
  ns := bt-child-slot(bt-word16(node))
  node-lt := tables[bits/wrapping-add(ns, 1u64)]
  node-gt := tables[bits/wrapping-add(ns, 2u64)]
  ~next := tables
  next[bits/wrapping-add(pending-lt, 1u64)] = node-lt
  next[bits/wrapping-add(pending-gt, 1u64)] = node-gt
  out := next.

// The same branch and prefix-bound updates are used in both compiled walks.
bt-descend-left(tables<[u16]>, pending-lt<u64>, pending-gt<u64>, node<u16>, best-gt<u64>, length<u64>) => (out<([u16],u64,u64,u16,u64,u64,u64)>) :=
  ns := bt-child-slot(bt-word16(node))
  ~next := tables
  next[bits/wrapping-add(pending-lt, 1u64)] = node
  new-lt := bits/wrapping-add(ns, 1u64)
  new-node := next[bits/wrapping-add(new-lt, 1u64)]
  out := (next, new-lt, pending-gt, new-node, length, best-gt, bt-minimum(best-gt, length)).
bt-descend-right(tables<[u16]>, pending-lt<u64>, pending-gt<u64>, node<u16>, best-lt<u64>, length<u64>) => (out<([u16],u64,u64,u16,u64,u64,u64)>) :=
  ns := bt-child-slot(bt-word16(node))
  ~next := tables
  next[bits/wrapping-add(pending-gt, 1u64)] = node
  new-node := next[bits/wrapping-add(ns, 1u64)]
  out := (next, pending-lt, ns, new-node, best-lt, length, bt-minimum(best-lt, length)).
bt-descend(tables<[u16]>, input<[u8]>, in-next<u64>, match-at<u64>, cur-pos<u64>, pending-lt<u64>, pending-gt<u64>, node<u16>, depth<u64>, best-lt<u64>, best-gt<u64>, length<u64>) => (out<bt-descent>) :=
  lesser := byte(input, bits/wrapping-add(match-at, length)) < byte(input, bits/wrapping-add(in-next, length))
  (mf, lt, gt, next-node, new-best-lt, new-best-gt, new-length) := (lesser?
    | true => bt-descend-left(tables, pending-lt, pending-gt, node, best-gt, length)
    | false => bt-descend-right(tables, pending-lt, pending-gt, node, best-lt, length))
  new-depth := bits/wrapping-sub(depth, 1u64)
  stopped := (bt-word16(next-node) <= cur-pos) || (new-depth == 0u64)
  next := (stopped? | true => bt-clear(mf, lt, gt) | false => mf)
  out := (next, lt, gt, next-node, new-depth, new-best-lt, new-best-gt, new-length, !stopped).

bt-search-after(tables<[u16]>, cache<[u32]>, cache-ptr<u64>, input<[u8]>, in-next<u64>, match-at<u64>, cur-pos<u64>, pending-lt<u64>, pending-gt<u64>, node<u16>, depth<u64>, best-lt<u64>, best-gt<u64>, length<u64>, best-length<u64>) => (out<bt-search-turn>) :=
  (mf, lt, gt, new-node, new-depth, new-best-lt, new-best-gt, new-length, walking) := bt-descend(tables, input, in-next, match-at, cur-pos, pending-lt, pending-gt, node, depth, best-lt, best-gt, length)
  out := (mf, cache, cache-ptr, lt, gt, new-node, new-depth, new-best-lt, new-best-gt, new-length, best-length, walking).
bt-search-step(tables<[u16]>, cache<[u32]>, cache-ptr<u64>, input<[u8]>, in-next<u64>, cur-pos<u64>, maximum<u64>, nice<u64>, pending-lt<u64>, pending-gt<u64>, node<u16>, depth<u64>, best-lt<u64>, best-gt<u64>, length<u64>, best-length<u64>) => (out<bt-search-turn>) :=
  distance := bits/and(bits/wrapping-sub(bits/wrapping-add(cur-pos, 32768u64), bt-word16(node)), 32767u64)
  match-at := bt-saturating-sub(in-next, distance)
  matched := byte(input, bits/wrapping-add(match-at, length)) == byte(input, bits/wrapping-add(in-next, length))
  extended := (matched? | true => extend-length(input, in-next, match-at, bits/wrapping-add(length, 1u64), maximum) | false => length)
  record := matched && (extended > best-length)
  next-cache := (record? | true => bt-put-entry(cache, cache-ptr, extended, bits/wrapping-sub(in-next, match-at)) | false => cache)
  next-ptr := (record? | true => bits/wrapping-add(cache-ptr, 1u64) | false => cache-ptr)
  new-best := (record? | true => extended | false => best-length)
  stopped := record && (extended >= nice)
  out := (stopped?
    | true => (bt-attach(tables, pending-lt, pending-gt, node), next-cache, next-ptr, pending-lt, pending-gt, node, depth, best-lt, best-gt, extended, new-best, false)
    | false => bt-search-after(tables, next-cache, next-ptr, input, in-next, match-at, cur-pos, pending-lt, pending-gt, node, depth, best-lt, best-gt, extended, new-best)).

bt-search-loop(tables<[u16]>, cache<[u32]>, cache-ptr<u64>, input<[u8]>, in-next<u64>, cur-pos<u64>, maximum<u64>, nice<u64>, out-hash3<u64>, out-hash4<u64>, pending-lt<u64>, pending-gt<u64>, node<u16>, depth<u64>, best-lt<u64>, best-gt<u64>, length<u64>, best-length<u64>) => (out<bt-advanced>) :=
  (mf, next-cache, next-ptr, lt, gt, next-node, next-depth, next-best-lt, next-best-gt, next-length, next-best, walking) := ((length < maximum)?
    | true => bt-search-step(tables, cache, cache-ptr, input, in-next, cur-pos, maximum, nice, pending-lt, pending-gt, node, depth, best-lt, best-gt, length, best-length)
    | false => (tables, cache, cache-ptr, pending-lt, pending-gt, node, depth, best-lt, best-gt, length, best-length, false))
  out := (walking?
    | true => bt-search-loop(mf, next-cache, next-ptr, input, in-next, cur-pos, maximum, nice, out-hash3, out-hash4, lt, gt, next-node, next-depth, next-best-lt, next-best-gt, next-length, next-best)
    | false => {tables: mf, next-hash3: out-hash3, next-hash4: out-hash4, cache: next-cache, cache-ptr: next-ptr}).

bt-short-candidates(input<[u8]>, in-next<u64>, in-base<u64>, cur-pos<u64>, node<u16>, older<u16>) => (out<u64>) :=
  seq3 := bits/and(bt-word32(load-prefix(input, in-next)), 16777215u64)
  out := ((seq3 == bits/and(bt-word32(load-prefix(input, node-index(in-base, node))), 16777215u64))?
        | true => bits/wrapping-sub(in-next, node-index(in-base, node))
        | false => ((bt-word16(older) > cur-pos)?
            | false => 0u64
            | true => ((seq3 == bits/and(bt-word32(load-prefix(input, node-index(in-base, older))), 16777215u64))?
                | true => bits/wrapping-sub(in-next, node-index(in-base, older))
                | false => 0u64))).
bt-short-distance(input<[u8]>, in-next<u64>, in-base<u64>, cur-pos<u64>, node<u16>, older<u16>) => (out<u64>) :=
  out := ((bt-word16(node) > cur-pos)?
    | false => 0u64
    | true => bt-short-candidates(input, in-next, in-base, cur-pos, node, older)).
bt-short-record(cache<[u32]>, cache-ptr<u64>, input<[u8]>, in-next<u64>, in-base<u64>, cur-pos<u64>, node<u16>, older<u16>) => (out<([u32],u64)>) :=
  distance := bt-short-distance(input, in-next, in-base, cur-pos, node, older)
  next := ((distance > 0u64)? | true => bt-put-entry(cache, cache-ptr, 3u64, distance) | false => cache)
  ptr := ((distance > 0u64)? | true => bits/wrapping-add(cache-ptr, 1u64) | false => cache-ptr)
  out := (next, ptr).

bt-get-matches(tables<[u16]>, hash3<u64>, hash4<u64>, input<[u8]>, in-base<u64>, cur-pos<u64>, maximum<u64>, nice<u64>, search-depth<u64>, cache<[u32]>, cache-ptr<u64>) => (out<bt-advanced>) :=
  table-size! := sequence/length(tables) >= 262144u64
  in-next := bits/wrapping-add(in-base, cur-pos)
  window! := in-next + maximum <= sequence/length(input)
  next-sequence := load-prefix(input, bits/wrapping-add(in-next, 1u64))
  seq3 := bt-narrow32(bits/and(bt-word32(next-sequence), 16777215u64))
  next-hash3 := lz-hash(seq3, 16u64)
  next-hash4 := lz-hash(next-sequence, 16u64)
  pos := bt-narrow16(bits/wrapping-add(cur-pos, 32768u64))
  slot3 := bits/wrapping-add(131072u64, bits/wrapping-mul(bits/and(hash3, 65535u64), 2u64))
  node3 := tables[bits/wrapping-add(slot3, 1u64)]
  older := tables[bits/wrapping-add(slot3, 2u64)]
  ~mf := tables
  mf[bits/wrapping-add(slot3, 1u64)] = pos
  mf[bits/wrapping-add(slot3, 2u64)] = node3
  (next-cache, next-ptr) := bt-short-record(cache, cache-ptr, input, in-next, in-base, cur-pos, node3, older)
  slot4 := bits/wrapping-add(65536u64, bits/and(hash4, 65535u64))
  node4 := mf[bits/wrapping-add(slot4, 1u64)]
  mf[bits/wrapping-add(slot4, 1u64)] = pos
  lt := bt-child-slot(cur-pos)
  gt := bits/wrapping-add(lt, 1u64)
  out := ((bt-word16(node4) <= cur-pos)?
    | true => {tables: bt-clear(mf, lt, gt), next-hash3: next-hash3, next-hash4: next-hash4, cache: next-cache, cache-ptr: next-ptr}
    | false => bt-search-loop(mf, next-cache, next-ptr, input, in-next, cur-pos, maximum, nice, next-hash3, next-hash4, lt, gt, node4, search-depth, 0u64, 0u64, 0u64, 3u64)).

// Skip has its own walk, with no cache, recording branch, or best-length state.
bt-skip-step(tables<[u16]>, input<[u8]>, in-next<u64>, cur-pos<u64>, nice<u64>, pending-lt<u64>, pending-gt<u64>, node<u16>, depth<u64>, best-lt<u64>, best-gt<u64>, length<u64>) => (out<bt-descent>) :=
  distance := bits/and(bits/wrapping-sub(bits/wrapping-add(cur-pos, 32768u64), bt-word16(node)), 32767u64)
  match-at := bt-saturating-sub(in-next, distance)
  matched := byte(input, bits/wrapping-add(match-at, length)) == byte(input, bits/wrapping-add(in-next, length))
  extended := (matched? | true => extend-length(input, in-next, match-at, bits/wrapping-add(length, 1u64), nice) | false => length)
  stopped := matched && (extended >= nice)
  out := (stopped?
    | true => (bt-attach(tables, pending-lt, pending-gt, node), pending-lt, pending-gt, node, depth, best-lt, best-gt, extended, false)
    | false => bt-descend(tables, input, in-next, match-at, cur-pos, pending-lt, pending-gt, node, depth, best-lt, best-gt, extended)).
bt-skip-loop(tables<[u16]>, input<[u8]>, in-next<u64>, cur-pos<u64>, nice<u64>, out-hash3<u64>, out-hash4<u64>, pending-lt<u64>, pending-gt<u64>, node<u16>, depth<u64>, best-lt<u64>, best-gt<u64>, length<u64>) => (out<bt-state>) :=
  (mf, lt, gt, next-node, next-depth, next-best-lt, next-best-gt, next-length, walking) := ((length < nice)?
    | true => bt-skip-step(tables, input, in-next, cur-pos, nice, pending-lt, pending-gt, node, depth, best-lt, best-gt, length)
    | false => (tables, pending-lt, pending-gt, node, depth, best-lt, best-gt, length, false))
  out := (walking?
    | true => bt-skip-loop(mf, input, in-next, cur-pos, nice, out-hash3, out-hash4, lt, gt, next-node, next-depth, next-best-lt, next-best-gt, next-length)
    | false => {tables: mf, next-hash3: out-hash3, next-hash4: out-hash4}).
bt-skip-byte(tables<[u16]>, hash3<u64>, hash4<u64>, input<[u8]>, in-base<u64>, cur-pos<u64>, nice<u64>, search-depth<u64>) => (out<bt-state>) :=
  table-size! := sequence/length(tables) >= 262144u64
  in-next := bits/wrapping-add(in-base, cur-pos)
  window! := in-next + nice <= sequence/length(input)
  next-sequence := load-prefix(input, bits/wrapping-add(in-next, 1u64))
  seq3 := bt-narrow32(bits/and(bt-word32(next-sequence), 16777215u64))
  next-hash3 := lz-hash(seq3, 16u64)
  next-hash4 := lz-hash(next-sequence, 16u64)
  pos := bt-narrow16(bits/wrapping-add(cur-pos, 32768u64))
  slot3 := bits/wrapping-add(131072u64, bits/wrapping-mul(bits/and(hash3, 65535u64), 2u64))
  node3 := tables[bits/wrapping-add(slot3, 1u64)]
  ~mf := tables
  mf[bits/wrapping-add(slot3, 1u64)] = pos
  mf[bits/wrapping-add(slot3, 2u64)] = node3
  slot4 := bits/wrapping-add(65536u64, bits/and(hash4, 65535u64))
  node4 := mf[bits/wrapping-add(slot4, 1u64)]
  mf[bits/wrapping-add(slot4, 1u64)] = pos
  lt := bt-child-slot(cur-pos)
  gt := bits/wrapping-add(lt, 1u64)
  out := ((bt-word16(node4) <= cur-pos)?
    | true => {tables: bt-clear(mf, lt, gt), next-hash3: next-hash3, next-hash4: next-hash4}
    | false => bt-skip-loop(mf, input, in-next, cur-pos, nice, next-hash3, next-hash4, lt, gt, node4, search-depth, 0u64, 0u64, 0u64)).

// Level-12 collection-position transition from CompressOptimal.roc,
// 671077457ff7ef3a3d44caf715a3fc595addf379, lines 783-916.
// Concatenate after the shared matchfinder and binary-tree functions.
// This prefix witness stops before the block decision/statistics code. It is
// not a complete block collector or compressor.

<optimal-position> := <{tables<[u16]> cache<[u32]> next-hash3<u64> next-hash4<u64> next-position<u64> cache-ptr<u64> base<u64> next-slide<u64> maximum<u64> nice<u64> skip<u64>}>

optimal-skip-position(tables<[u16]>, hash3<u64>, hash4<u64>, input<[u8]>, base<u64>, position<u64>, nice<u64>, cache<[u32]>, pointer<u64>) => (out<bt-advanced>) :=
  advanced := bt-skip-byte(tables, hash3, hash4, input, base, position, nice, 300u64)
  out := {tables: advanced.tables, next-hash3: advanced.next-hash3, next-hash4: advanced.next-hash4, cache: cache, cache-ptr: pointer}.

optimal-collect-position(tables<[u16]>, cache<[u32]>, hash3<u64>, hash4<u64>, input<[u8]>, position<u64>, base<u64>, next-slide<u64>, maximum<u64>, nice<u64>, skip<u64>, pointer<u64>) => (out<optimal-position>) :=
  remaining := bits/wrapping-sub(sequence/length(input), position)
  slide := position == next-slide
  mf := (slide? | true => rebase-nodes(tables) | false => tables)
  current-base := (slide? | true => position | false => base)
  slide-at := (slide? | true => bits/wrapping-add(position, bt-minimum(remaining, 32768u64)) | false => next-slide)
  max-length := ((remaining < 258u64)? | true => remaining | false => maximum)
  nice-length := ((remaining < 258u64)? | true => bt-minimum(nice, max-length) | false => nice)
  skipping := skip != 0u64
  advanced := ((max-length >= 5u64)?
    | true => (skipping?
        | true => optimal-skip-position(mf, hash3, hash4, input, current-base, bits/wrapping-sub(position, current-base), nice-length, cache, pointer)
        | false => bt-get-matches(mf, hash3, hash4, input, current-base, bits/wrapping-sub(position, current-base), max-length, nice-length, 300u64, cache, pointer))
    | false => {tables: mf, next-hash3: hash3, next-hash4: hash4, cache: cache, cache-ptr: pointer})
  next-tables := advanced.tables
  next-hash3 := advanced.next-hash3
  next-hash4 := advanced.next-hash4
  next-cache := advanced.cache
  next-pointer := advanced.cache-ptr
  found := next-pointer > pointer
  best := (found? | true => bits/and(bt-word32(next-cache[next-pointer]), 65535u64) | false => 0u64)
  with-header := bt-put-entry(next-cache, next-pointer, bits/wrapping-sub(next-pointer, pointer), byte(input, position))
  next-skip := (skipping?
    | true => bits/wrapping-sub(skip, 1u64)
    | false => (((best >= 3u64) && (best >= nice-length))? | true => bits/wrapping-sub(best, 1u64) | false => 0u64))
  out := {tables: next-tables, cache: with-header, next-hash3: next-hash3, next-hash4: next-hash4, next-position: bits/wrapping-add(position, 1u64), cache-ptr: bits/wrapping-add(next-pointer, 1u64), base: current-base, next-slide: slide-at, maximum: max-length, nice: nice-length, skip: next-skip}.

// The bounded witness uses the same consecutive transition and keeps the
// table/cache separate at call sites, as the full compression loop does.
optimal-collect-prefix-loop(tables<[u16]>, cache<[u32]>, hash3<u64>, hash4<u64>, input<[u8]>, position<u64>, base<u64>, next-slide<u64>, maximum<u64>, nice<u64>, skip<u64>, pointer<u64>, end<u64>) => (out<optimal-position>) :=
  collecting := position < end
  next := (collecting?
    | false => {tables: tables, cache: cache, next-hash3: hash3, next-hash4: hash4, next-position: position, cache-ptr: pointer, base: base, next-slide: next-slide, maximum: maximum, nice: nice, skip: skip}
    | true => optimal-collect-position(tables, cache, hash3, hash4, input, position, base, next-slide, maximum, nice, skip, pointer))
  next-tables := next.tables
  next-cache := next.cache
  next-hash3 := next.next-hash3
  next-hash4 := next.next-hash4
  next-position := next.next-position
  next-base := next.base
  slide-at := next.next-slide
  max-length := next.maximum
  nice-length := next.nice
  next-skip := next.skip
  next-pointer := next.cache-ptr
  out := (collecting?
    | false => {tables: next-tables, cache: next-cache, next-hash3: next-hash3, next-hash4: next-hash4, next-position: next-position, cache-ptr: next-pointer, base: next-base, next-slide: slide-at, maximum: max-length, nice: nice-length, skip: next-skip}
    | true => optimal-collect-prefix-loop(next-tables, next-cache, next-hash3, next-hash4, input, next-position, next-base, slide-at, max-length, nice-length, next-skip, next-pointer, end)).

optimal-collect-prefix(input<[u8]>, end<u64>) => (out<optimal-position>) :=
  tables := initial-nodes(262144u64)
  cache := [0u32 | i <- 0u64..=1500513u64, i < 1500513u64]
  out := optimal-collect-prefix-loop(tables, cache, 0u64, 0u64, input, 0u64, 0u64, bt-minimum(sequence/length(input), 32768u64), 258u64, 258u64, 0u64, 0u64, bt-minimum(end, sequence/length(input))).

// Block statistics from CompressOptimal.merge_match_len_freqs and
// CompressLazy.merge_observations, pinned at
// 671077457ff7ef3a3d44caf715a3fc595addf379. Concatenate after shared helpers.
// Counters retain their original U32 representation and checked merge addition.
// These functions are components of the block collector, not its complete loop.

<optimal-merged-frequencies> := <{total<[u32]> fresh<[u32]>}>
<optimal-merged-observations> := <{new-observations<[u32]> observations<[u32]> num-new-observations<u64> num-observations<u64>}>

optimal-counter(counters<[u32]>, index<u64>) => (out<u32>) :=
  out := ((index < sequence/length(counters))? | true => counters[index + 1u64] | false => 0u32).

optimal-merge-frequency(total<[u32]>, fresh<[u32]>, index<u64>, amount<u32>) => (out<optimal-merged-frequencies>) :=
  merged := optimal-counter(total, index) + amount
  ~next-total := total
  next-total[index + 1u64] = merged
  ~next-fresh := fresh
  next-fresh[index + 1u64] = 0u32
  out := {total: next-total, fresh: next-fresh}.

optimal-merge-frequency-if(total<[u32]>, fresh<[u32]>, index<u64>) => (out<optimal-merged-frequencies>) :=
  amount := optimal-counter(fresh, index)
  out := ((amount != 0u32)?
    | true => optimal-merge-frequency(total, fresh, index, amount)
    | false => {total: total, fresh: fresh}).

optimal-merge-frequencies-loop(total<[u32]>, fresh<[u32]>, index<u64>) => (out<optimal-merged-frequencies>) :=
  merged := ((index <= 258u64)?
    | true => optimal-merge-frequency-if(total, fresh, index)
    | false => {total: total, fresh: fresh})
  next-total := merged.total
  next-fresh := merged.fresh
  out := ((index <= 258u64)?
    | false => {total: next-total, fresh: next-fresh}
    | true => optimal-merge-frequencies-loop(next-total, next-fresh, index + 1u64)).

optimal-merge-frequencies(total<[u32]>, fresh<[u32]>) => (out<optimal-merged-frequencies>) :=
  out := optimal-merge-frequencies-loop(total, fresh, 0u64).

optimal-merge-observation(new-observations<[u32]>, new-base<u64>, observations<[u32]>, index<u64>) => (out<optimal-merged-frequencies>) :=
  merged := optimal-counter(observations, index) + optimal-counter(new-observations, new-base + index)
  ~next-total := observations
  next-total[index + 1u64] = merged
  ~next-fresh := new-observations
  next-fresh[new-base + index + 1u64] = 0u32
  out := {total: next-total, fresh: next-fresh}.

optimal-merge-observations-loop(new-observations<[u32]>, new-base<u64>, observations<[u32]>, index<u64>) => (out<optimal-merged-frequencies>) :=
  merged := ((index < 10u64)?
    | true => optimal-merge-observation(new-observations, new-base, observations, index)
    | false => {total: observations, fresh: new-observations})
  next-total := merged.total
  next-fresh := merged.fresh
  out := ((index < 10u64)?
    | false => {total: next-total, fresh: next-fresh}
    | true => optimal-merge-observations-loop(next-fresh, new-base, next-total, index + 1u64)).

optimal-merge-observations(new-observations<[u32]>, new-base<u64>, observations<[u32]>, num-new-observations<u64>, num-observations<u64>) => (out<optimal-merged-observations>) :=
  merged := optimal-merge-observations-loop(new-observations, new-base, observations, 0u64)
  out := {new-observations: merged.fresh, observations: merged.total, num-new-observations: 0u64, num-observations: num-observations + num-new-observations}.

// Level-12-reachable block heuristics from CompressLazy.roc at
// 671077457ff7ef3a3d44caf715a3fc595addf379. Shared helpers precede this file.

optimal-choose-minimum(used<u64>) => (out<u64>) :=
  lengths := [9u8,9u8,9u8,9u8,9u8,9u8,8u8,8u8,7u8,7u8,6u8,6u8,6u8,6u8,6u8,6u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,5u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8,4u8]
  out := ((used >= 80u64)? | true => 3u64 | false => byte(lengths, used)).

optimal-used-count(used<[u8]>, index<u64>, count<u64>) => (out<u64>) :=
  out := ((index < 256u64)?
    | true => optimal-used-count(used, index + 1u64, count + byte(used, index))
    | false => count).

optimal-mark-used(used<[u8]>, input<[u8]>, at<u64>) => (out<[u8]>) :=
  ~next := used
  next[byte(input, at) + 1u64] = 1u8
  out := next.

optimal-sample-used(used<[u8]>, input<[u8]>, at<u64>, count<u64>, index<u64>) => (out<[u8]>) :=
  next := ((index < count)? | true => optimal-mark-used(used, input, at + index) | false => used)
  out := ((index < count)?
    | true => optimal-sample-used(next, input, at, count, index + 1u64)
    | false => next).

optimal-sampled-minimum(input<[u8]>, at<u64>, count<u64>) => (out<u64>) :=
  used := [0u8 | index <- 0u64..=256u64, index < 256u64]
  sampled := optimal-sample-used(used, input, at, bt-minimum(count, 4096u64), 0u64)
  out := optimal-choose-minimum(optimal-used-count(sampled, 0u64, 0u64)).

optimal-minimum-match(input<[u8]>, at<u64>, count<u64>) => (out<u64>) :=
  out := ((count < 512u64)? | true => 3u64 | false => optimal-sampled-minimum(input, at, count)).

optimal-maximum-block-end(begin<u64>, end<u64>) => (out<u64>) :=
  out := ((end - begin < 305000u64)? | true => end | false => begin + 300000u64).

optimal-observation-delta(fresh<[u32]>, total<[u32]>, num-fresh<u64>, num-total<u64>, index<u64>, delta<u64>) => (out<u64>) :=
  expected := ((index < 10u64)? | true => bt-word32(optimal-counter(total, index)) * num-fresh | false => 0u64)
  actual := ((index < 10u64)? | true => bt-word32(optimal-counter(fresh, index)) * num-total | false => 0u64)
  difference := ((actual > expected)? | true => actual - expected | false => expected - actual)
  out := ((index < 10u64)?
    | true => optimal-observation-delta(fresh, total, num-fresh, num-total, index + 1u64, delta + difference)
    | false => delta).

optimal-end-check-present(fresh<[u32]>, total<[u32]>, num-fresh<u64>, num-total<u64>, block-length<u64>) => (out<u64>) :=
  delta := optimal-observation-delta(fresh, total, num-fresh, num-total, 0u64, 0u64)
  items := num-total + num-fresh
  initial-cutoff := (num-fresh * 200u64 / 512u64) * num-total
  cutoff := (((block-length < 10000u64) && (items < 8192u64))?
    | true => initial-cutoff + initial-cutoff * (8192u64 - items) / 8192u64
    | false => initial-cutoff)
  out := ((delta + (block-length / 4096u64) * num-total >= cutoff)? | true => 1u64 | false => 0u64).

optimal-end-block-check(fresh<[u32]>, total<[u32]>, num-fresh<u64>, num-total<u64>, block-length<u64>) => (out<u64>) :=
  out := ((num-total > 0u64)?
    | true => optimal-end-check-present(fresh, total, num-fresh, num-total, block-length)
    | false => 0u64).

// Level-12 match collection from CompressOptimal.roc:753-970 and 1232-1273,
// pinned at 671077457ff7ef3a3d44caf715a3fc595addf379.
// Concatenate after matchfinder, binary-tree, prefix, statistics and heuristics.
// Large buffers remain separate function arguments. The actual tree skip has
// no cache argument: its caller writes each position's zero-match header.

<optimal-sample> := <{fresh-frequencies<[u32]> fresh-observations<[u32]> number-fresh<u64> next-observation<u64>}>
<optimal-sampled-position> := <{tables<[u16]> cache<[u32]> next-hash3<u64> next-hash4<u64> next-position<u64> cache-ptr<u64> base<u64> next-slide<u64> maximum<u64> nice<u64> skip<u64> fresh-frequencies<[u32]> fresh-observations<[u32]> number-fresh<u64> next-observation<u64>}>
<optimal-block-decision> := <{frequencies<[u32]> fresh-frequencies<[u32]> observations<[u32]> fresh-observations<[u32]> number-observations<u64> number-fresh<u64> previous-check<u64> have-previous-check<u64> changed<u64> keep-going<bool>}>
<optimal-collected-block> := <{tables<[u16]> cache<[u32]> next-hash3<u64> next-hash4<u64> next-position<u64> cache-ptr<u64> base<u64> next-slide<u64> maximum<u64> nice<u64> frequencies<[u32]> fresh-frequencies<[u32]> observations<[u32]> fresh-observations<[u32]> number-observations<u64> number-fresh<u64> block-begin<u64> block-end<u64> cache-end<u64> rewound<u64> is-final<u64> changed<u64> previous-check<u64> have-previous-check<u64>}>
<optimal-carried-block> := <{cache<[u32]> cache-ptr<u64> frequencies<[u32]> fresh-frequencies<[u32]> observations<[u32]> fresh-observations<[u32]> number-observations<u64> number-fresh<u64> block-begin<u64>}>

optimal-increment-counter(counters<[u32]>, index<u64>) => (out<[u32]>) :=
  value := bt-narrow32(bits/wrapping-add(bt-word32(optimal-counter(counters, index)), 1u64))
  ~next := counters
  next[index + 1u64] = value
  out := next.

optimal-sample-match(frequencies<[u32]>, observations<[u32]>, number<u64>, position<u64>, best<u64>) => (out<optimal-sample>) :=
  kind := 8u64 + ((best >= 9u64)? | true => 1u64 | false => 0u64)
  fresh-observations := optimal-increment-counter(observations, kind)
  next-number := bits/wrapping-add(number, 1u64)
  next-observation := bits/wrapping-add(position, best)
  fresh-frequencies := optimal-increment-counter(frequencies, best)
  out := {fresh-frequencies: fresh-frequencies, fresh-observations: fresh-observations, number-fresh: next-number, next-observation: next-observation}.

optimal-sample-literal(frequencies<[u32]>, observations<[u32]>, number<u64>, position<u64>, input<[u8]>) => (out<optimal-sample>) :=
  literal := byte(input, position)
  kind := bits/or(bits/and(bits/shift-right-wrap(literal, 5u64), 6u64), bits/and(literal, 1u64))
  fresh := optimal-increment-counter(observations, kind)
  out := {fresh-frequencies: frequencies, fresh-observations: fresh, number-fresh: bits/wrapping-add(number, 1u64), next-observation: bits/wrapping-add(position, 1u64)}.

optimal-sample-position(frequencies<[u32]>, observations<[u32]>, number<u64>, next-observation<u64>, position<u64>, best<u64>, minimum<u64>, input<[u8]>) => (out<optimal-sample>) :=
  out := ((position >= next-observation)?
    | false => {fresh-frequencies: frequencies, fresh-observations: observations, number-fresh: number, next-observation: next-observation}
    | true => ((best >= minimum)?
        | true => optimal-sample-match(frequencies, observations, number, position, best)
        | false => optimal-sample-literal(frequencies, observations, number, position, input))).

optimal-search-position(tables<[u16]>, cache<[u32]>, hash3<u64>, hash4<u64>, input<[u8]>, position<u64>, base<u64>, next-slide<u64>, maximum<u64>, nice<u64>, pointer<u64>, frequencies<[u32]>, observations<[u32]>, number<u64>, next-observation<u64>, minimum<u64>) => (out<optimal-sampled-position>) :=
  remaining := bits/wrapping-sub(sequence/length(input), position)
  slide := position == next-slide
  mf := (slide? | true => rebase-nodes(tables) | false => tables)
  current-base := (slide? | true => position | false => base)
  slide-at := (slide? | true => bits/wrapping-add(position, bt-minimum(remaining, 32768u64)) | false => next-slide)
  max-length := ((remaining < 258u64)? | true => remaining | false => maximum)
  nice-length := ((remaining < 258u64)? | true => bt-minimum(nice, max-length) | false => nice)
  advanced := ((max-length >= 5u64)?
    | true => bt-get-matches(mf, hash3, hash4, input, current-base, bits/wrapping-sub(position, current-base), max-length, nice-length, 300u64, cache, pointer)
    | false => {tables: mf, next-hash3: hash3, next-hash4: hash4, cache: cache, cache-ptr: pointer})
  next-tables := advanced.tables
  next-cache := advanced.cache
  next-hash3 := advanced.next-hash3
  next-hash4 := advanced.next-hash4
  next-pointer := advanced.cache-ptr
  best := ((next-pointer > pointer)? | true => bits/and(bt-word32(next-cache[next-pointer]), 65535u64) | false => 0u64)
  sampled := optimal-sample-position(frequencies, observations, number, next-observation, position, best, minimum, input)
  fresh-frequencies := sampled.fresh-frequencies
  fresh-observations := sampled.fresh-observations
  number-fresh := sampled.number-fresh
  observe-at := sampled.next-observation
  with-header := bt-put-entry(next-cache, next-pointer, bits/wrapping-sub(next-pointer, pointer), byte(input, position))
  skip := (((best >= 3u64) && (best >= nice-length))? | true => bits/wrapping-sub(best, 1u64) | false => 0u64)
  out := {tables: next-tables, cache: with-header, next-hash3: next-hash3, next-hash4: next-hash4, next-position: bits/wrapping-add(position, 1u64), cache-ptr: bits/wrapping-add(next-pointer, 1u64), base: current-base, next-slide: slide-at, maximum: max-length, nice: nice-length, skip: skip, fresh-frequencies: fresh-frequencies, fresh-observations: fresh-observations, number-fresh: number-fresh, next-observation: observe-at}.

optimal-skip-run(tables<[u16]>, cache<[u32]>, hash3<u64>, hash4<u64>, input<[u8]>, position<u64>, base<u64>, next-slide<u64>, maximum<u64>, nice<u64>, skip<u64>, pointer<u64>) => (out<optimal-position>) :=
  next := ((skip != 0u64)?
    | true => optimal-collect-position(tables, cache, hash3, hash4, input, position, base, next-slide, maximum, nice, skip, pointer)
    | false => {tables: tables, cache: cache, next-hash3: hash3, next-hash4: hash4, next-position: position, cache-ptr: pointer, base: base, next-slide: next-slide, maximum: maximum, nice: nice, skip: skip})
  next-tables := next.tables
  next-cache := next.cache
  next-hash3 := next.next-hash3
  next-hash4 := next.next-hash4
  next-position := next.next-position
  next-base := next.base
  slide-at := next.next-slide
  max-length := next.maximum
  nice-length := next.nice
  next-skip := next.skip
  next-pointer := next.cache-ptr
  out := ((skip != 0u64)?
    | true => optimal-skip-run(next-tables, next-cache, next-hash3, next-hash4, input, next-position, next-base, slide-at, max-length, nice-length, next-skip, next-pointer)
    | false => {tables: next-tables, cache: next-cache, next-hash3: next-hash3, next-hash4: next-hash4, next-position: next-position, cache-ptr: next-pointer, base: next-base, next-slide: slide-at, maximum: max-length, nice: nice-length, skip: next-skip}).

optimal-merge-checkpoint(frequencies<[u32]>, fresh-frequencies<[u32]>, observations<[u32]>, fresh-observations<[u32]>, number-observations<u64>, number-fresh<u64>, position<u64>) => (out<optimal-block-decision>) :=
  ms := optimal-merge-observations(fresh-observations, 0u64, observations, number-fresh, number-observations)
  merged := optimal-merge-frequencies(frequencies, fresh-frequencies)
  out := {frequencies: merged.total, fresh-frequencies: merged.fresh, observations: ms.observations, fresh-observations: ms.new-observations, number-observations: ms.num-observations, number-fresh: ms.num-new-observations, previous-check: position, have-previous-check: 1u64, changed: 0u64, keep-going: true}.

optimal-block-decision(frequencies<[u32]>, fresh-frequencies<[u32]>, observations<[u32]>, fresh-observations<[u32]>, number-observations<u64>, number-fresh<u64>, position<u64>, begin<u64>, maximum-end<u64>, pointer<u64>, end<u64>, previous-check<u64>, have-previous-check<u64>) => (out<optimal-block-decision>) :=
  at-limit := (position >= maximum-end) || (pointer >= 1500000u64)
  check := !at-limit && (number-fresh >= 512u64) && (bits/wrapping-sub(position, begin) >= 5000u64) && (bits/wrapping-sub(end, position) >= 5000u64)
  changed := (check? | true => optimal-end-block-check(fresh-observations, observations, number-fresh, number-observations, bits/wrapping-sub(position, begin)) | false => 0u64)
  out := ((check && (changed == 0u64))?
    | true => optimal-merge-checkpoint(frequencies, fresh-frequencies, observations, fresh-observations, number-observations, number-fresh, position)
    | false => {frequencies: frequencies, fresh-frequencies: fresh-frequencies, observations: observations, fresh-observations: fresh-observations, number-observations: number-observations, number-fresh: number-fresh, previous-check: previous-check, have-previous-check: have-previous-check, changed: changed, keep-going: !at-limit && (changed == 0u64)}).

optimal-rewind-cache(cache<[u32]>, end<u64>, count<u64>) => (out<u64>) :=
  header-at := ((count != 0u64)? | true => end - 1u64 | false => end)
  previous := ((count != 0u64)? | true => header-at - bits/and(bt-word32(optimal-counter(cache, header-at)), 65535u64) | false => end)
  out := ((count != 0u64)? | true => optimal-rewind-cache(cache, previous, count - 1u64) | false => previous).

optimal-finish-block(tables<[u16]>, cache<[u32]>, hash3<u64>, hash4<u64>, position<u64>, pointer<u64>, base<u64>, next-slide<u64>, maximum<u64>, nice<u64>, frequencies<[u32]>, fresh-frequencies<[u32]>, observations<[u32]>, fresh-observations<[u32]>, number-observations<u64>, number-fresh<u64>, begin<u64>, end<u64>, previous-check<u64>, have-previous-check<u64>, changed<u64>) => (out<optimal-collected-block>) :=
  rewind := (changed == 1u64) && (have-previous-check == 1u64)
  block-end := (rewind? | true => previous-check | false => position)
  cache-end := (rewind? | true => optimal-rewind-cache(cache, pointer, position - previous-check) | false => pointer)
  rewound := (rewind? | true => pointer - cache-end | false => 0u64)
  merged := (rewind? | true => {total: frequencies, fresh: fresh-frequencies} | false => optimal-merge-frequencies(frequencies, fresh-frequencies))
  ms := (rewind?
    | true => {new-observations: fresh-observations, observations: observations, num-new-observations: number-fresh, num-observations: number-observations}
    | false => optimal-merge-observations(fresh-observations, 0u64, observations, number-fresh, number-observations))
  final := ((!rewind && (position == end))? | true => 1u64 | false => 0u64)
  out := {tables: tables, cache: cache, next-hash3: hash3, next-hash4: hash4, next-position: position, cache-ptr: pointer, base: base, next-slide: next-slide, maximum: maximum, nice: nice, frequencies: merged.total, fresh-frequencies: merged.fresh, observations: ms.observations, fresh-observations: ms.new-observations, number-observations: ms.num-observations, number-fresh: ms.num-new-observations, block-begin: begin, block-end: block-end, cache-end: cache-end, rewound: rewound, is-final: final, changed: changed, previous-check: previous-check, have-previous-check: have-previous-check}.

optimal-block-loop(tables<[u16]>, cache<[u32]>, hash3<u64>, hash4<u64>, input<[u8]>, position<u64>, base<u64>, next-slide<u64>, maximum<u64>, nice<u64>, pointer<u64>, frequencies<[u32]>, fresh-frequencies<[u32]>, observations<[u32]>, fresh-observations<[u32]>, number-observations<u64>, number-fresh<u64>, next-observation<u64>, begin<u64>, maximum-end<u64>, minimum<u64>, previous-check<u64>, have-previous-check<u64>) => (out<optimal-collected-block>) :=
  searched := optimal-search-position(tables, cache, hash3, hash4, input, position, base, next-slide, maximum, nice, pointer, fresh-frequencies, fresh-observations, number-fresh, next-observation, minimum)
  mf := searched.tables
  matches := searched.cache
  nh3 := searched.next-hash3
  nh4 := searched.next-hash4
  at := searched.next-position
  current-base := searched.base
  slide-at := searched.next-slide
  max-length := searched.maximum
  nice-length := searched.nice
  skip := searched.skip
  ptr := searched.cache-ptr
  new-frequencies := searched.fresh-frequencies
  new-observations := searched.fresh-observations
  new-number := searched.number-fresh
  observe-at := searched.next-observation
  advanced := optimal-skip-run(mf, matches, nh3, nh4, input, at, current-base, slide-at, max-length, nice-length, skip, ptr)
  next-tables := advanced.tables
  next-cache := advanced.cache
  next-hash3 := advanced.next-hash3
  next-hash4 := advanced.next-hash4
  next-position := advanced.next-position
  next-base := advanced.base
  next-slide-at := advanced.next-slide
  next-maximum := advanced.maximum
  next-nice := advanced.nice
  next-pointer := advanced.cache-ptr
  decision := optimal-block-decision(frequencies, new-frequencies, observations, new-observations, number-observations, new-number, next-position, begin, maximum-end, next-pointer, sequence/length(input), previous-check, have-previous-check)
  total-frequencies := decision.frequencies
  fresh-freqs := decision.fresh-frequencies
  total-observations := decision.observations
  fresh-obs := decision.fresh-observations
  num-total := decision.number-observations
  num-fresh := decision.number-fresh
  prev-check := decision.previous-check
  have-prev := decision.have-previous-check
  changed := decision.changed
  out := (decision.keep-going?
    | true => optimal-block-loop(next-tables, next-cache, next-hash3, next-hash4, input, next-position, next-base, next-slide-at, next-maximum, next-nice, next-pointer, total-frequencies, fresh-freqs, total-observations, fresh-obs, num-total, num-fresh, observe-at, begin, maximum-end, minimum, prev-check, have-prev)
    | false => optimal-finish-block(next-tables, next-cache, next-hash3, next-hash4, next-position, next-pointer, next-base, next-slide-at, next-maximum, next-nice, total-frequencies, fresh-freqs, total-observations, fresh-obs, num-total, num-fresh, begin, sequence/length(input), prev-check, have-prev, changed)).

optimal-collect-block(tables<[u16]>, cache<[u32]>, hash3<u64>, hash4<u64>, input<[u8]>, position<u64>, base<u64>, next-slide<u64>, maximum<u64>, nice<u64>, pointer<u64>, frequencies<[u32]>, fresh-frequencies<[u32]>, observations<[u32]>, fresh-observations<[u32]>, number-observations<u64>, number-fresh<u64>, begin<u64>, previous-only-literals<u64>) => (out<optimal-collected-block>) :=
  maximum-end := optimal-maximum-block-end(begin, sequence/length(input))
  minimum := ((previous-only-literals == 1u64)? | true => 259u64 | false => optimal-minimum-match(input, begin, maximum-end - begin))
  out := optimal-block-loop(tables, cache, hash3, hash4, input, position, base, next-slide, maximum, nice, pointer, frequencies, fresh-frequencies, observations, fresh-observations, number-observations, number-fresh, position, begin, maximum-end, minimum, 0u64, 0u64).

optimal-first-block(input<[u8]>) => (out<optimal-collected-block>) :=
  tables := initial-nodes(262144u64)
  cache := [0u32 | index <- 0u64..=1500513u64, index < 1500513u64]
  frequencies := [0u32 | index <- 0u64..=259u64, index < 259u64]
  fresh-frequencies := [0u32 | index <- 0u64..=259u64, index < 259u64]
  observations := [0u32 | index <- 0u64..=10u64, index < 10u64]
  fresh-observations := [0u32 | index <- 0u64..=10u64, index < 10u64]
  out := optimal-collect-block(tables, cache, 0u64, 0u64, input, 0u64, 0u64, bt-minimum(sequence/length(input), 32768u64), 258u64, 258u64, 0u64, frequencies, fresh-frequencies, observations, fresh-observations, 0u64, 0u64, 0u64, 0u64).

optimal-move-carry-entry(cache<[u32]>, index<u64>, value<u32>) => (out<[u32]>) :=
  ~next := cache
  next[index + 1u64] = value
  out := next.

optimal-move-carry(cache<[u32]>, source<u64>, count<u64>, index<u64>) => (out<[u32]>) :=
  value := ((index < count)? | true => optimal-counter(cache, source + index) | false => 0u32)
  next := ((index < count)? | true => optimal-move-carry-entry(cache, index, value) | false => cache)
  out := ((index < count)? | true => optimal-move-carry(next, source, count, index + 1u64) | false => next).

optimal-carry-rewound(cache<[u32]>, cache-end<u64>, rewound<u64>, fresh-frequencies<[u32]>, fresh-observations<[u32]>, number-fresh<u64>, block-end<u64>) => (out<optimal-carried-block>) :=
  next-cache := optimal-move-carry(cache, cache-end, rewound, 0u64)
  observations := [0u32 | index <- 0u64..=10u64, index < 10u64]
  frequencies := [0u32 | index <- 0u64..=259u64, index < 259u64]
  out := {cache: next-cache, cache-ptr: rewound, frequencies: frequencies, fresh-frequencies: fresh-frequencies, observations: observations, fresh-observations: fresh-observations, number-observations: 0u64, number-fresh: number-fresh, block-begin: block-end}.

optimal-carry-reset(cache<[u32]>, position<u64>) => (out<optimal-carried-block>) :=
  fresh-observations := [0u32 | index <- 0u64..=10u64, index < 10u64]
  observations := [0u32 | index <- 0u64..=10u64, index < 10u64]
  fresh-frequencies := [0u32 | index <- 0u64..=259u64, index < 259u64]
  frequencies := [0u32 | index <- 0u64..=259u64, index < 259u64]
  out := {cache: cache, cache-ptr: 0u64, frequencies: frequencies, fresh-frequencies: fresh-frequencies, observations: observations, fresh-observations: fresh-observations, number-observations: 0u64, number-fresh: 0u64, block-begin: position}.

optimal-carry-block(cache<[u32]>, cache-end<u64>, rewound<u64>, changed<u64>, have-previous-check<u64>, fresh-frequencies<[u32]>, fresh-observations<[u32]>, number-fresh<u64>, position<u64>, block-end<u64>) => (out<optimal-carried-block>) :=
  out := (((changed == 1u64) && (have-previous-check == 1u64))?
    | true => optimal-carry-rewound(cache, cache-end, rewound, fresh-frequencies, fresh-observations, number-fresh, block-end)
    | false => optimal-carry-reset(cache, position)).

// Near-optimal backward path search from roc-deflate
// 671077457ff7ef3a3d44caf715a3fc595addf379, CompressOptimal.roc.
// U64 nodes contain U32 cost and item halves. Cost arithmetic wraps at 32 bits.
// See deflate-huffman-LICENSES.md for source attribution and licenses.
+> bits
+> sequence
<optimal-path> := <{nodes<[u64]>}>
<optimal-choice> := <{best<u32> item<u32> k<u64>}>
<optimal-matches> := <{best<u32> item<u32> cache-ptr<u64>}>

optimal-word32(value<u32>) => (out<u64>) :=
  out<u64> := value.
optimal-narrow32(value<u64>) => (out<u32>) :=
  out<u32> := bits/and(value, 4294967295u64).
optimal-add-cost(left<u32>, right<u32>) => (out<u32>) :=
  out := optimal-narrow32(bits/wrapping-add(optimal-word32(left), optimal-word32(right))).
optimal-get32(values<[u32]>, at<u64>) => <u32>
  | (values, at) => ((at < sequence/length(values))? | true => values[bits/wrapping-add(at, 1u64)] | false => 0u32).
optimal-get64(values<[u64]>, at<u64>) => <u64>
  | (values, at) => ((at < sequence/length(values))? | true => values[bits/wrapping-add(at, 1u64)] | false => 0u64).
optimal-offset-slot(offset<u64>, slots<[u8]>) => (out<u64>) :=
  n := bits/shift-right-wrap(bits/and(bits/wrapping-sub(256u64, optimal-word32(optimal-narrow32(offset))), 4294967295u64), 29u64)
  at := bits/shift-right-wrap(bits/wrapping-sub(offset, 1u64), n)
  byte := ((at < sequence/length(slots))? | true => slots[bits/wrapping-add(at, 1u64)] | false => 0u8)
  wide<u64> := byte
  out := bits/wrapping-add(wide, bits/shift-left-wrap(n, 1u64)).
optimal-node-top(block-length<u64>) => (out<u64>) :=
  out := bits/wrapping-add(bits/wrapping-sub(block-length, 1u64), 258u64).
optimal-checked-match-length(value<u64>) => (out<u64>) :=
  cached-length! := (value <= 258u64) && (value >= 3u64)
  out := value.

optimal-path-guards(nodes<[u64]>, guard<u64>, block-length<u64>) => <[u64]>
  | (nodes, guard, block-length) => ((guard != block-length)?
      | true => optimal-path-guards(sequence/append(nodes, 2147483648u64), bits/wrapping-sub(guard, 1u64), block-length)
      | false => nodes).

// The read-only tables are captures; only scalar cursors and choices change.
#OptimalPathLengths(nodes<[u64]>, length-costs<[u32]>, offset-cost<u32>, offset<u64>, len-count<u64>, k<u64>, best<u32>, item<u32>) => <optimal-choice>
  | :Try(k<u64>, best<u32>, item<u32>)
  | :Done(k<u64>, best<u32>, item<u32>).
#OptimalPathLengths(nodes, length-costs, offset-cost, offset, len-count, k, best, item) -> :Try(k, best, item)
  :Try(k, best, item)
    | k < len-count -> {
        length := bits/wrapping-add(k, 3u64)
        length-cost := optimal-get32(length-costs, length)
        partial-cost := optimal-add-cost(offset-cost, length-cost)
        tail-cost := optimal-narrow32(optimal-get64(nodes, bits/wrapping-sub(sequence/length(nodes), length)))
        cost := optimal-add-cost(partial-cost, tail-cost)
        next-best := ((cost < best)? | true => cost | false => best)
        next-item := ((cost < best)? | true => optimal-narrow32(bits/or(length, bits/shift-left-wrap(optimal-word32(optimal-narrow32(offset)), 9u64))) | false => item)
      } -> :Try(bits/wrapping-add(k, 1u64), next-best, next-item)
    | * -> :Done(k, best, item)
  :Done(k, best, item) => {best: best, item: item, k: k}.

#OptimalPathMatches(nodes<[u64]>, cache<[u32]>, cp<u64>, number<u64>, length-costs<[u32]>, offset-costs<[u32]>, slots<[u8]>, best<u32>, item<u32>) => <optimal-matches>
  | :Try(m<u64>, k<u64>, best<u32>, item<u32>)
  | :Done(best<u32>, item<u32>).
#OptimalPathMatches(nodes, cache, cp, number, length-costs, offset-costs, slots, best, item) -> :Try(bits/wrapping-sub(cp, number), 0u64, best, item)
  :Try(m, k, best, item)
    | m != cp -> {
        offset := bits/shift-right-wrap(optimal-word32(optimal-get32(cache, m)), 16u64)
        offset-cost := optimal-get32(offset-costs, optimal-offset-slot(offset, slots))
        this-length := bits/and(optimal-word32(optimal-get32(cache, m)), 65535u64)
        len-count := optimal-checked-match-length(this-length) - 2u64
        choice := #OptimalPathLengths(nodes, length-costs, offset-cost, offset, len-count, k, best, item)
      } -> :Try(bits/wrapping-add(m, 1u64), choice.k, choice.best, choice.item)
    | * -> :Done(best, item)
  :Done(best, item) => {best: best, item: item, cache-ptr: bits/wrapping-sub(cp, number)}.

optimal-path-position(nodes<[u64]>, cur<u64>, cp<u64>, cache<[u32]>, literal-costs<[u32]>, length-costs<[u32]>, offset-costs<[u32]>, slots<[u8]>) => (out<([u64],u64,u64)>) :=
  next-cur := bits/wrapping-sub(cur, 1u64)
  header-ptr := bits/wrapping-sub(cp, 1u64)
  number := bits/and(optimal-word32(optimal-get32(cache, header-ptr)), 65535u64)
  literal := bits/shift-right-wrap(optimal-word32(optimal-get32(cache, header-ptr)), 16u64)
  best := optimal-add-cost(optimal-get32(literal-costs, literal), optimal-narrow32(optimal-get64(nodes, bits/wrapping-sub(sequence/length(nodes), 1u64))))
  item := optimal-narrow32(bits/or(bits/shift-left-wrap(optimal-word32(optimal-narrow32(literal)), 9u64), 1u64))
  choice := #OptimalPathMatches(nodes, cache, header-ptr, number, length-costs, offset-costs, slots, best, item)
  node := bits/or(optimal-word32(choice.best), bits/shift-left-wrap(optimal-word32(choice.item), 32u64))
  out := (sequence/append(nodes, node), next-cur, choice.cache-ptr).

optimal-path-scan(nodes<[u64]>, cur<u64>, cp<u64>, cache<[u32]>, literal-costs<[u32]>, length-costs<[u32]>, offset-costs<[u32]>, slots<[u8]>) => (out<[u64]>) :=
  more := cur != 0u64
  step := (more? | true => optimal-path-position(nodes, cur, cp, cache, literal-costs, length-costs, offset-costs, slots) | false => (nodes, cur, cp))
  (next-nodes, next-cur, next-cp) := step
  out := (more? | true => optimal-path-scan(next-nodes, next-cur, next-cp, cache, literal-costs, length-costs, offset-costs, slots) | false => nodes).

optimal-find-min-cost-path(block-length<u64>, cache<[u32]>, cache-end<u64>, nodes0<[u64]>, literal-costs<[u32]>, length-costs<[u32]>, offset-costs<[u32]>, slots<[u8]>) => (out<optimal-path>) :=
  top := optimal-node-top(block-length)
  length-table! := sequence/length(length-costs) >= 259u64
  cleared := sequence/clear(nodes0)
  guarded := optimal-path-guards(cleared, top, block-length)
  nodes := sequence/append(guarded, 0u64)
  node-window! := sequence/length(nodes) >= 258u64
  result := optimal-path-scan(nodes, block-length, cache-end, cache, literal-costs, length-costs, offset-costs, slots)
  out := {nodes: result}.

// Length-limited canonical Huffman construction for DEFLATE.
// Port of libdeflate b122c8be1d78b19f6d0a6efc5bb79bfcbb30dd51,
// following roc-deflate 671077457ff7ef3a3d44caf715a3fc595addf379.
// Copyright 2016 Eric Biggers (MIT); Copyright 2024 Niclas Åhdén (Apache-2.0).
// See deflate-huffman-LICENSES.md for attribution and licenses.
+> bits
+> sequence
<huff-code> := <{lens<[u8]> codewords<[u32]>}>
<huff-sorted> := <{symout<[u32]> lens<[u8]> num-used-syms<u64>}>
<huff-counted> := <{a<[u32]> len-counts<[u64]>}>
<huff-generated> := <{a<[u32]> lens<[u8]>}>

huff-word(value<u32>) => (out<u64>) :=
  out<u64> := value.
huff-packed(value<u64>) => (out<u32>) :=
  out<u32> := bits/and(value, 4294967295u64).
huff-byte(value<u64>) => (out<u8>) :=
  out<u8> := bits/and(value, 255u64).
huff-minimum(a<u64>, b<u64>) => (out<u64>) :=
  out := ((a < b)? | true => a | false => b).
huff-get8(values<[u8]>, at<u64>) => <u8>
  | (values, at) => ((at < sequence/length(values))? | true => values[bits/wrapping-add(at, 1u64)] | false => 0u8).
huff-get32(values<[u32]>, at<u64>) => <u32>
  | (values, at) => ((at < sequence/length(values))? | true => values[bits/wrapping-add(at, 1u64)] | false => 0u32).
huff-get64(values<[u64]>, at<u64>) => <u64>
  | (values, at) => ((at < sequence/length(values))? | true => values[bits/wrapping-add(at, 1u64)] | false => 0u64).
huff-set8(values<[u8]>, at<u64>, value<u8>) => (out<[u8]>) :=
  ~next := values
  next[bits/wrapping-add(at, 1u64)] = value
  out := next.
huff-set32(values<[u32]>, at<u64>, value<u32>) => (out<[u32]>) :=
  ~next := values
  next[bits/wrapping-add(at, 1u64)] = value
  out := next.
huff-set64(values<[u64]>, at<u64>, value<u64>) => (out<[u64]>) :=
  ~next := values
  next[bits/wrapping-add(at, 1u64)] = value
  out := next.
huff-add-wrap32(a<u32>, b<u32>) => (out<u32>) :=
  out := huff-packed(bits/wrapping-add(huff-word(a), huff-word(b))).
huff-tree-frequency(a<[u32]>, at<u64>) => (out<u64>) :=
  out := bits/and(huff-word(huff-get32(a, at)), 4294966272u64).
huff-reverse-byte(value<u64>) => (out<u64>) :=
  a := bits/or(bits/shift-right-wrap(value, 4u64), bits/and(bits/shift-left-wrap(value, 4u64), 255u64))
  b := bits/or(bits/shift-right-wrap(bits/and(a, 204u64), 2u64), bits/shift-left-wrap(bits/and(a, 51u64), 2u64))
  out := bits/or(bits/shift-right-wrap(bits/and(b, 170u64), 1u64), bits/shift-left-wrap(bits/and(b, 85u64), 1u64)).
huff-reverse-codeword(value<u32>, width<u64>, reversed<[u8]>) => (out<u32>) :=
  wide := huff-word(value)
  low<u64> := huff-get8(reversed, bits/and(wide, 255u64))
  high<u64> := huff-get8(reversed, bits/shift-right-wrap(wide, 8u64))
  out := huff-packed(bits/shift-right-wrap(bits/or(bits/shift-left-wrap(low, 8u64), high), 16u64 - width)).
huff-build-reversal-at(table<[u8]>, i<u64>) => <[u8]>
  | (table, i) => ((i < 256u64)? | true => huff-build-reversal-at(sequence/append(table, huff-byte(huff-reverse-byte(i))), i + 1u64) | false => table).
huff-build-reversal() => (out<[u8]>) :=
  out := huff-build-reversal-at(sequence/with-capacity(0u8, 256u64), 0u64).

huff-count-step(freqs<[u32]>, counts<[u64]>, sym<u64>, top<u64>) => (out<[u64]>) :=
  slot := huff-minimum(huff-word(huff-get32(freqs, sym)), top)
  count := huff-get64(counts, slot) + 1u64
  out := huff-set64(counts, slot, count).
huff-count-symbols(freqs<[u32]>, n<u64>, counts<[u64]>, sym<u64>, top<u64>) => <[u64]>
  | (freqs, n, counts, sym, top) => ((sym < n)? | true => huff-count-symbols(freqs, n, huff-count-step(freqs, counts, sym, top), sym + 1u64, top) | false => counts).
huff-cumulative-step(counts<[u64]>, used<u64>, i<u64>) => (out<([u64],u64)>) :=
  count := huff-get64(counts, i)
  next := huff-set64(counts, i, used)
  out := (next, used + count).
huff-cumulative(counts<[u64]>, n<u64>, used<u64>, i<u64>) => (out<([u64],u64)>) :=
  more := i < n
  step := (more? | true => huff-cumulative-step(counts, used, i) | false => (counts, used))
  (next, next-used) := step
  out := (more? | true => huff-cumulative(next, n, next-used, i + 1u64) | false => (counts, used)).
huff-place-nonzero(counts<[u64]>, lens<[u8]>, a<[u32]>, freq<u32>, sym<u64>, top<u64>) => (out<([u64],[u8],[u32])>) :=
  slot := huff-minimum(huff-word(freq), top)
  at := huff-get64(counts, slot)
  next-counts := huff-set64(counts, slot, at + 1u64)
  packed := huff-packed(bits/or(huff-word(huff-packed(sym)), bits/shift-left-wrap(huff-word(freq), 10u64)))
  next-a := huff-set32(a, at, packed)
  out := (next-counts, lens, next-a).
huff-place-step(freqs<[u32]>, counts<[u64]>, lens<[u8]>, a<[u32]>, sym<u64>, top<u64>) => (out<([u64],[u8],[u32])>) :=
  freq := huff-get32(freqs, sym)
  out := ((freq != 0u32)? | true => huff-place-nonzero(counts, lens, a, freq, sym, top) | false => (counts, huff-set8(lens, sym, 0u8), a)).
huff-place-symbols(freqs<[u32]>, n<u64>, counts<[u64]>, lens<[u8]>, a<[u32]>, sym<u64>, top<u64>) => (out<([u64],[u8],[u32])>) :=
  more := sym < n
  step := (more? | true => huff-place-step(freqs, counts, lens, a, sym, top) | false => (counts, lens, a))
  (next-counts, next-lens, next-a) := step
  out := (more? | true => huff-place-symbols(freqs, n, next-counts, next-lens, next-a, sym + 1u64, top) | false => (counts, lens, a)).

huff-sift-child(a<[u32]>, base<u64>, size<u64>, child<u64>) => (out<u64>) :=
  out := ((child < size && huff-get32(a, base + child) > huff-get32(a, base + child - 1u64))? | true => child + 1u64 | false => child).
huff-sift-descend(a<[u32]>, base<u64>, size<u64>, parent<u64>, child0<u64>, value<u32>) => (out<([u32],u64,bool)>) :=
  child := huff-sift-child(a, base, size, child0)
  child-value := huff-get32(a, base + child - 1u64)
  more := value < child-value
  next := (more? | true => huff-set32(a, base + parent - 1u64, child-value) | false => a)
  next-parent := (more? | true => child | false => parent)
  out := (next, next-parent, more).
huff-sift-loop(a<[u32]>, base<u64>, size<u64>, parent<u64>, value<u32>) => (out<[u32]>) :=
  child0 := parent * 2u64
  step := ((child0 > size)? | true => (a, parent, false) | false => huff-sift-descend(a, base, size, parent, child0, value))
  (next, next-parent, more) := step
  out := (more? | true => huff-sift-loop(next, base, size, next-parent, value) | false => huff-set32(next, base + next-parent - 1u64, value)).
huff-heapify(a<[u32]>, base<u64>, size<u64>, root<u64>) => (out<[u32]>) :=
  value := huff-get32(a, base + root - 1u64)
  out := huff-sift-loop(a, base, size, root, value).
huff-heap-build(a<[u32]>, base<u64>, size<u64>, root<u64>) => <[u32]>
