  "schema":"prolog-source-reader-v1",
  "source":"/Users/cim310/.codex/worktrees/clbg-nbody-v04/mech/benchmarks/clbg/prolog-comparison/20261013/revisions/prepare-success-halt-v1/sources/pidigits/optimized.pl",
  "source_text":":- module(clbg_pidigits, [main/0]).\n:- use_module('../../support/clbg_io').\n:- initialization(clbg_io:run(clbg_pidigits:main), main).\n\npadding(0) :- !.\npadding(N) :-\n    put_code(32),\n    Remaining is N - 1,\n    padding(Remaining).\n\nfinish_line(Count, Column) :-\n    (   Column > 0\n    ->  Spaces is 10 - Column,\n        padding(Spaces),\n        format('\\t:~d~n', [Count])\n    ;   true\n    ).\n\ndigits(N, N, Column, _, _, _, _) :-\n    !,\n    finish_line(N, Column).\ndigits(N, Count, Column, Q, R, T, K) :-\n    Numerator3 is 3 * Q + R,\n    Numerator4 is 4 * Q + R,\n    Digit3 is Numerator3 div T,\n    Digit4 is Numerator4 div T,\n    (   Digit3 =:= Digit4\n    ->  Code is 48 + Digit3,\n        put_code(Code),\n        NextCount is Count + 1,\n        NextColumn0 is Column + 1,\n        (   NextColumn0 =:= 10\n        ->  format('\\t:~d~n', [NextCount]),\n            NextColumn = 0\n        ;   NextColumn = NextColumn0\n        ),\n        NextQ is Q * 10,\n        NextR is 10 * (R - Digit3 * T),\n        digits(N, NextCount, NextColumn, NextQ, NextR, T, K)\n    ;   Factor is 2 * K + 1,\n        NextQ is Q * K,\n        NextR is (2 * Q + R) * Factor,\n        NextT is T * Factor,\n        NextK is K + 1,\n        digits(N, Count, Column, NextQ, NextR, NextT, NextK)\n    ).\n\nmain :-\n    size(N),\n    current_prolog_flag(bounded, false),\n    digits(N, 0, 0, 1, 0, 1, 1).\n",
  "version": [10, 0, 2 ]
}
