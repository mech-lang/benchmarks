  "schema":"prolog-source-reader-v1",
  "source":"/Users/cim310/.codex/worktrees/clbg-nbody-v04/mech/benchmarks/clbg/prolog-comparison/20261013/revisions/prepare-success-halt-v1/sources/mandelbrot/optimized.pl",
  "source_text":":- module(clbg_mandelbrot, [main/0]).\n:- use_module('../../support/clbg_io').\n:- initialization(clbg_io:run(clbg_mandelbrot:main), main).\n\nescape(0, _, _, _, _, 1) :- !.\nescape(Iterations, CR, CI, ZR, ZI, Bit) :-\n    ZR2 is ZR * ZR,\n    ZI2 is ZI * ZI,\n    NextZI is 2.0 * ZR * ZI + CI,\n    NextZR is ZR2 - ZI2 + CR,\n    Magnitude is NextZR * NextZR + NextZI * NextZI,\n    (   Magnitude > 4.0\n    ->  Bit = 0\n    ;   Remaining is Iterations - 1,\n        escape(Remaining, CR, CI, NextZR, NextZI, Bit)\n    ).\n\npixel(X, N, _, 0) :- X >= N, !.\npixel(X, N, CI, Bit) :-\n    CR is 2.0 * X / N - 1.5,\n    escape(50, CR, CI, 0.0, 0.0, Bit).\n\npacked(8, _, _, _, Byte, Byte) :- !.\npacked(Bits, X, N, CI, Accumulator, Byte) :-\n    pixel(X, N, CI, Bit),\n    NextAccumulator is Accumulator * 2 + Bit,\n    NextBits is Bits + 1,\n    NextX is X + 1,\n    packed(NextBits, NextX, N, CI, NextAccumulator, Byte).\n\nrow(X, N, _) :- X >= N, !.\nrow(X, N, CI) :-\n    packed(0, X, N, CI, 0, Byte),\n    put_code(Byte),\n    NextX is X + 8,\n    row(NextX, N, CI).\n\nrows(Y, N) :- Y >= N, !.\nrows(Y, N) :-\n    CI is 2.0 * Y / N - 1.0,\n    row(0, N, CI),\n    NextY is Y + 1,\n    rows(NextY, N).\n\nmain :-\n    size(N),\n    format('P4~n~d ~d~n', [N, N]),\n    rows(0, N).\n",
  "version": [10, 0, 2 ]
}
