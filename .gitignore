# Local caches and generated artifacts; authored crate lockfiles stay versioned.
.DS_Store
__pycache__/
*.py[cod]
.venv/
.local/
**/target/
**/node_modules/
**/.build/
**/owner.lock
**/*.owner.lock
/migration/*.marks
/migration/*.stderr

/site/public/

# Large measured stdout files remain local; receipts retain their byte counts and hashes.
/experiments/mech/interpreted-whole-process-v1/*/samples/*/stdout.bin

# Lean native diagnostics and large measured output; reports retain their hashes.
/experiments/lean4/required-work-v1/binarytrees-counted
/experiments/lean4/full-*/**/stdout.bin
/experiments/lean4/input-preparation-*/**/stdout.bin
/experiments/lean4/optimization-v1/full-*/**/stdout.bin

# Luau complete output is verified locally; committed receipts retain size/hash.
/experiments/luau/full-*/**/stdout.bin

# Ruby JIT output is checked in full; receipts retain byte counts and hashes.
/experiments/ruby-jit/full-*/**/stdout.bin

# Locally rebuilt generic bindings; source and build/hash receipts are retained.
/experiments/bqn/optimization-v1/stdlib/*.dylib

# FASTA's complete measured output is checked locally; retain byte/hash receipts.
/experiments/bqn/fasta-bins-v1/full-*/**/stdout.bin

# Admission previews duplicate the complete catalog; pinned evidence and the
# deterministic appender are retained instead of a second catalog snapshot.
/experiments/bqn/optimization-v1/admission-v1/prepared.json
/experiments/bqn/spectral-sum-v1/admission-v1/prepared.json
/experiments/bqn/fasta-bins-v1/admission-v1/prepared.json
/experiments/nim/optimization-v1/admission-v1/prepared.json
/experiments/matlab/optimization-v1/admission-v1/prepared.json
experiments/clojure/optimization-v1/primitive-v1/admission-v1/prepared.json
experiments/futhark/library-map-review-v1/correction-v1/prepared.json
